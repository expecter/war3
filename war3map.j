//===========================================================================
// Trigger: peiyao
//===========================================================================
function Trig_peiyaoConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0CZ' ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == false ) )
endfunction

function Trig_peiyaoActions takes nothing returns nothing
    set udg_bizhong[0]=( ( 5.00 - I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ) / I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) )
    set udg_bizhong[1]=( ( 1.00 + I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ) / 2.00 )
    set udg_bizhong[2]=( ( 1.00 + I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ) / ( 5.00 - I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ) )
    set udg_bizhong[3]=( ( 1.00 + I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ) / Pow(( 5.00 - I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ), 2.00) )
    call ConditionalTriggerExecute(gg_trg_wupinci)
    call YDWEPolledWaitNull(15.00)
    if ( ( GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit()) == 1 ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01T') == true ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == false ) ) then
        call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call IssueImmediateOrder(GetTriggerUnit(), "unimmolation")
        call PlaceRandomItem(udg_wupinchi[GetConvertedPlayerId(GetTriggerPlayer())], GetLocationX(GetUnitLoc(GetTriggerUnit())), GetLocationY(GetUnitLoc(GetTriggerUnit())))
    else
        if ( ( GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit()) == 2 ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01T') == true ) ) then
            call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
            call DestroyEffect(GetLastCreatedEffectBJ())
            call IssueImmediateOrder(GetTriggerUnit(), "unimmolation")
            call PlaceRandomItem(udg_wupinchi[GetConvertedPlayerId(GetTriggerPlayer())], GetLocationX(GetUnitLoc(GetTriggerUnit())), GetLocationY(GetUnitLoc(GetTriggerUnit())))
        else
            if ( ( GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit()) == 3 ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01T') == true ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == false ) ) then
                call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
                call DestroyEffect(GetLastCreatedEffectBJ())
                call IssueImmediateOrder(GetTriggerUnit(), "unimmolation")
                call PlaceRandomItem(udg_wupinchi[GetConvertedPlayerId(GetTriggerPlayer())], GetLocationX(GetUnitLoc(GetTriggerUnit())), GetLocationY(GetUnitLoc(GetTriggerUnit())))
            else
                if ( ( GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit()) == 4 ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01T') == true ) ) then
                    call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
                    call DestroyEffect(GetLastCreatedEffectBJ())
                    call IssueImmediateOrder(GetTriggerUnit(), "unimmolation")
                    call PlaceRandomItem(udg_wupinchi[GetConvertedPlayerId(GetTriggerPlayer())], GetLocationX(GetUnitLoc(GetTriggerUnit())), GetLocationY(GetUnitLoc(GetTriggerUnit())))
                else
                    if ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == false ) ) then
                        call CreateTextTagUnitBJ("TRIGSTR_090", GetTriggerUnit(), 0, 10, 100, 0.00, 0.00, 0)
                        call SetTextTagLifespan(GetLastCreatedTextTag(), 1.00)
                        call SetTextTagVelocityBJ(GetLastCreatedTextTag(), 64, 90)
                        call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl")
                        call DestroyEffect(GetLastCreatedEffectBJ())
                        call UnitDamagePoint(GetTriggerUnit(), 0, 400.00, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 300.00, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNKNOWN, WEAPON_TYPE_WHOKNOWS)
                        call IssueImmediateOrder(GetTriggerUnit(), "unimmolation")
                    else
                    endif
                endif
            endif
        endif
    endif
    call DestroyItemPool(udg_wupinchi[GetConvertedPlayerId(GetTriggerPlayer())])
endfunction

//===========================================================================
function InitTrig_peiyao takes nothing returns nothing
    set gg_trg_peiyao=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_peiyao, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_peiyao, Condition(function Trig_peiyaoConditions))
    call TriggerAddAction(gg_trg_peiyao, function Trig_peiyaoActions)
endfunction

//===========================================================================
// Trigger: peiyao 2
//===========================================================================
function Trig_peiyao_2Conditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0CZ' ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == true ) )
endfunction

function Trig_peiyao_2Actions takes nothing returns nothing
    set udg_bizhong[0]=( ( 5.00 - I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ) / I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) )
    set udg_bizhong[1]=( ( 1.00 + I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ) / 2.00 )
    set udg_bizhong[2]=( ( 1.00 + I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ) / ( 5.00 - I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ) )
    set udg_bizhong[3]=( ( 1.00 + I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ) / Pow(( 5.00 - I2R(GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit())) ), 2.00) )
    call ConditionalTriggerExecute(gg_trg_wupinci)
    call YDWEPolledWaitNull(5.00)
    if ( ( GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit()) == 1 ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01T') == true ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == true ) ) then
        call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call IssueImmediateOrder(GetTriggerUnit(), "unimmolation")
        call PlaceRandomItem(udg_wupinchi[GetConvertedPlayerId(GetTriggerPlayer())], GetLocationX(GetUnitLoc(GetTriggerUnit())), GetLocationY(GetUnitLoc(GetTriggerUnit())))
    else
        if ( ( GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit()) == 2 ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == true ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01T') == true ) ) then
            call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
            call DestroyEffect(GetLastCreatedEffectBJ())
            call IssueImmediateOrder(GetTriggerUnit(), "unimmolation")
            call PlaceRandomItem(udg_wupinchi[GetConvertedPlayerId(GetTriggerPlayer())], GetLocationX(GetUnitLoc(GetTriggerUnit())), GetLocationY(GetUnitLoc(GetTriggerUnit())))
        else
            if ( ( GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit()) == 3 ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01T') == true ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == true ) ) then
                call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
                call DestroyEffect(GetLastCreatedEffectBJ())
                call IssueImmediateOrder(GetTriggerUnit(), "unimmolation")
                call PlaceRandomItem(udg_wupinchi[GetConvertedPlayerId(GetTriggerPlayer())], GetLocationX(GetUnitLoc(GetTriggerUnit())), GetLocationY(GetUnitLoc(GetTriggerUnit())))
            else
                if ( ( GetUnitAbilityLevelSwapped('A0CZ', GetTriggerUnit()) == 4 ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == true ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01T') == true ) ) then
                    call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
                    call DestroyEffect(GetLastCreatedEffectBJ())
                    call IssueImmediateOrder(GetTriggerUnit(), "unimmolation")
                    call PlaceRandomItem(udg_wupinchi[GetConvertedPlayerId(GetTriggerPlayer())], GetLocationX(GetUnitLoc(GetTriggerUnit())), GetLocationY(GetUnitLoc(GetTriggerUnit())))
                else
                    if ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B01U') == true ) ) then
                        call CreateTextTagUnitBJ("TRIGSTR_4456", GetTriggerUnit(), 0, 10, 100, 0.00, 0.00, 0)
                        call SetTextTagLifespan(GetLastCreatedTextTag(), 1.00)
                        call SetTextTagVelocityBJ(GetLastCreatedTextTag(), 64, 90)
                        call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl")
                        call DestroyEffect(GetLastCreatedEffectBJ())
                        call UnitDamagePoint(GetTriggerUnit(), 0, 800.00, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 1000.00, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNKNOWN, WEAPON_TYPE_WHOKNOWS)
                        call IssueImmediateOrder(GetTriggerUnit(), "unimmolation")
                    else
                    endif
                endif
            endif
        endif
    endif
    call DestroyItemPool(udg_wupinchi[GetConvertedPlayerId(GetTriggerPlayer())])
endfunction

