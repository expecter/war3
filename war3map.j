    set gg_trg_anshadaodiaoluo=CreateTrigger()
    call TriggerRegisterUnitEvent(gg_trg_anshadaodiaoluo, gg_unit_nrzg_0299, EVENT_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_anshadaodiaoluo, Condition(function Trig_anshadaodiaoluoConditions))
