endfunction

function Trig_luorikuanglanjinengActions takes nothing returns nothing
    if ( ( GetUnitAbilityLevelSwapped('A047', GetTriggerUnit()) == 1 ) ) then
        set udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetLoc()
        call PauseUnitBJ(true, GetTriggerUnit())
        call SetUnitAnimation(GetTriggerUnit(), "stand victory")
        call SetUnitTimeScalePercent(GetTriggerUnit(), 200.00)
        call YDWEPolledWaitNull(3.50)
        call PauseUnitBJ(false, GetTriggerUnit())
        call SetUnitTimeScalePercent(GetTriggerUnit(), 100.00)
        call CreateNUnitsAtLoc(1, 'n01I', GetTriggerPlayer(), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())]) / 1.70 ), AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())])), bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(6.00, 'BTLF', GetLastCreatedUnit())
        call SetUnitFlyHeight(GetLastCreatedUnit(), 600.00, 0.00)
        call UnitAddAbilityBJ('A0D8', GetLastCreatedUnit())
        call IssuePointOrderLoc(GetLastCreatedUnit(), "clusterrockets", udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())])
        call RemoveLocation(udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())])
    else
        set udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetLoc()
        call AddSpecialEffectTargetUnitBJ("weapon", GetTriggerUnit(), "Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call PauseUnitBJ(true, GetTriggerUnit())
        call SetUnitAnimation(GetTriggerUnit(), "stand victory")
        call SetUnitTimeScalePercent(GetTriggerUnit(), 200.00)
        call YDWEPolledWaitNull(3.50)
        call PauseUnitBJ(false, GetTriggerUnit())
        call SetUnitTimeScalePercent(GetTriggerUnit(), 100.00)
        call CreateNUnitsAtLoc(1, 'n01I', GetTriggerPlayer(), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())]) / 1.70 ), AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())])), bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(6.00, 'BTLF', GetLastCreatedUnit())
        call SetUnitFlyHeight(GetLastCreatedUnit(), 600.00, 0.00)
        call UnitAddAbilityBJ('A0D8', GetLastCreatedUnit())
        call IssuePointOrderLoc(GetLastCreatedUnit(), "clusterrockets", udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())])
        call YDWEPolledWaitNull(2.00)
        call UnitAddAbilityBJ('AHfs', GetLastCreatedUnit())
        call SetUnitAbilityLevelSwapped('AHfs', GetLastCreatedUnit(), 3)
        call IssuePointOrderLoc(GetLastCreatedUnit(), "flamestrike", udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())])
        call RemoveLocation(udg_kuanglanjineng[GetConvertedPlayerId(GetTriggerPlayer())])
    endif
endfunction

