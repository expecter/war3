//===========================================================================
function Trig_busiConditions takes nothing returns boolean
    return ( ( GetUnitTypeId(GetTriggerUnit()) == 'uzg1' ) and ( GetPlayerController(GetTriggerPlayer()) != MAP_CONTROL_USER ) and ( udg_shengji[GetConvertedPlayerId(GetTriggerPlayer())] <= 5 ) )
endfunction

function Trig_busiActions takes nothing returns nothing
    call YDWEPolledWaitNull(240.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 'nshr')
    set udg_shengji[GetConvertedPlayerId(GetTriggerPlayer())]=( udg_shengji[GetConvertedPlayerId(GetTriggerPlayer())] + 1 )
endfunction

