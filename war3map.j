//===========================================================================
// Trigger: shengbai
//===========================================================================
function Trig_shengbaiActions takes nothing returns nothing
    if ( ( GetPlayerStructureCount(Player(8), true) == 0 ) and ( GetPlayerStructureCount(Player(9), true) == 0 ) and ( GetPlayerStructureCount(Player(10), true) == 0 ) ) then
        call CustomVictoryBJ(Player(0), true, true)
        call CustomVictoryBJ(Player(1), true, true)
        call CustomVictoryBJ(Player(2), true, true)
        call CustomVictoryBJ(Player(3), true, true)
        call CustomVictoryBJ(Player(4), true, true)
        call CustomVictoryBJ(Player(5), true, true)
    else
    endif
endfunction

//===========================================================================
function InitTrig_shengbai takes nothing returns nothing
    set gg_trg_shengbai=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_shengbai, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(gg_trg_shengbai, function Trig_shengbaiActions)
endfunction

