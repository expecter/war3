    return ( ( GetSpellAbilityId() == 'A03D' ) and ( ( GetUnitTypeId(GetTriggerUnit()) == 'E00E' ) or ( GetUnitTypeId(GetTriggerUnit()) == 'E00F' ) ) )
endfunction

function Trig_siwangzhizhiActions takes nothing returns nothing
    call UnitDamageTarget(GetTriggerUnit(), GetSpellTargetUnit(), ( 100.00 * I2R(GetUnitAbilityLevelSwapped('A03D', GetTriggerUnit())) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_DEATH, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("overhead", GetSpellTargetUnit(), "Objects\\Spawnmodels\\Undead\\UDeathSmall\\UDeathSmall.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

