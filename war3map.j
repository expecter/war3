function Trig_anshadaodiaoluoConditions takes nothing returns boolean
    return ( ( IsUnitInGroup(GetTriggerUnit(), (YDWEGetUnitsOfPlayerMatchingNull((Player(PLAYER_NEUTRAL_AGGRESSIVE)) , null))) == true ) and ( IsUnitIllusionBJ(GetTriggerUnit()) == false ) and ( IsUnitType(GetKillingUnitBJ(), UNIT_TYPE_HERO) == true ) ) // INLINED!!
endfunction

function Trig_anshadaodiaoluoActions takes nothing returns nothing
    if ( ( GetRandomInt(1, 10) == 5 ) ) then
        call CreateItemLoc('I09G', GetUnitLoc(GetTriggerUnit()))
    else
        if ( ( GetRandomInt(1, 2) == 2 ) ) then
            call CreateItemLoc('I074', GetUnitLoc(GetTriggerUnit()))
        else
            if ( ( GetRandomInt(1, 2) == 1 ) ) then
                call CreateItemLoc('I065', GetUnitLoc(GetTriggerUnit()))
            else
                call CreateItemLoc('I067', GetUnitLoc(GetTriggerUnit()))
            endif
        endif
    endif
endfunction

