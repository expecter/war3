//===========================================================================
function Trig_fangzisiwangConditions takes nothing returns boolean
    return ( ( udg_cunmingchulai == false ) )
endfunction

function Trig_fangzisiwangActions takes nothing returns nothing
    call YDWEPolledWaitNull(1.00)
    call CreateNUnitsAtLoc(1, 'n005', Player(PLAYER_NEUTRAL_PASSIVE), GetUnitLoc(gg_unit_ndh1_0171), bj_UNIT_FACING)
    call SetUnitLifePercentBJ(GetLastCreatedUnit(), 0.00)
endfunction

