endfunction

function Trig_qirenzhanFunc003001 takes nothing returns boolean
    return ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B03G') == false ) )
endfunction

function Trig_qirenzhanActions takes nothing returns nothing
    call UnitAddAbilityBJ('A0O3', GetTriggerUnit())
    call YDWEPolledWaitNull(1.00)
    loop
        exitwhen ( (UnitHasBuffBJ(GetTriggerUnit(), 'B03G') == false) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    call UnitRemoveAbilityBJ('A0O3', GetTriggerUnit())
endfunction

