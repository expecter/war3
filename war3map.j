//===========================================================================
// Trigger: shizihou
//===========================================================================
function Trig_shizihouConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A06P' ) )
endfunction

function Trig_shizihouActions takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'n01G', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    call SetUnitScalePercent(GetLastCreatedUnit(), 200.00, 200.00, 200.00)
    call AddSpecialEffectTargetUnitBJ("overhead", GetLastCreatedUnit(), "Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl")
    call UnitAddAbilityBJ('A00L', GetLastCreatedUnit())
    call IssueImmediateOrder(GetLastCreatedUnit(), "roar")
    call RemoveUnit(GetLastCreatedUnit())
    call UnitAddAbilityBJ('A0BH', GetTriggerUnit())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(GetTriggerUnit(), 100, ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), 0.00)
        call YDWEPolledWaitNull(4.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call UnitRemoveAbilityBJ('A0BH', GetTriggerUnit())
    call SetUnitVertexColor(GetTriggerUnit(), 255, 255, 255, 255)
endfunction

//===========================================================================
function InitTrig_shizihou takes nothing returns nothing
    set gg_trg_shizihou=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_shizihou, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_shizihou, Condition(function Trig_shizihouConditions))
