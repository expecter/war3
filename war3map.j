function InitTrig_huodewupin takes nothing returns nothing
    set gg_trg_huodewupin=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_huodewupin, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_huodewupin, Condition(function Trig_huodewupinConditions))
