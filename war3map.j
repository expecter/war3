    if ( ( ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Hamg')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Hvsh')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Hblm')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Ofar')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Othr')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Oshd')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('O00F')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Ulic')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Ekee')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Emns')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Nngs')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Nbst')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('H00R')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('Nalc')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('N00N')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('E009')) == true ) or ( IsUnitInGroup(GetAttacker(), YDWEGetUnitsOfTypeIdAllNull('U002')) == true ) ) ) then
        if ( ( GetRandomInt(1, 4) == 4 ) ) then
            call CreateUnitAtLoc(GetOwningPlayer(GetAttacker()), 'h01B', GetUnitLoc(GetTriggerUnit()), 0)
            call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "war3mapImported\\HolyBurst.mdx")
            call DestroyEffect(GetLastCreatedEffectBJ())
            call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(500.00 , GetUnitLoc(GetTriggerUnit()) , Condition(function Trig_mofajiejiegongjiFunc001Func001Func004001003)), function Trig_mofajiejiegongjiFunc001Func001Func004A)
