        call SelectHeroSkill(GetLastReplacedUnitBJ(), 'A09Q')
        call SelectHeroSkill(GetLastReplacedUnitBJ(), 'A09Q')
        call SelectHeroSkill(GetLastReplacedUnitBJ(), 'A0A9')
        call SelectHeroSkill(GetLastReplacedUnitBJ(), 'A0A9')
        call SelectHeroSkill(GetLastReplacedUnitBJ(), 'A0A9')
    else
    endif
    call DisableTrigger(GetTriggeringTrigger())
endfunction

