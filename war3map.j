//===========================================================================
// Trigger: nongminchulai
//===========================================================================
function Trig_nongminchulaiConditions takes nothing returns boolean
    return ( ( ( GetTriggerUnit() == gg_unit_nmtw_0134 ) or ( GetTriggerUnit() == gg_unit_nmbg_0136 ) or ( GetTriggerUnit() == gg_unit_nmsn_0133 ) or ( GetTriggerUnit() == gg_unit_nmbg_0135 ) or ( GetTriggerUnit() == gg_unit_nmtw_0186 ) or ( GetTriggerUnit() == gg_unit_nmsc_0406 ) or ( GetTriggerUnit() == gg_unit_nmsc_0408 ) or ( GetTriggerUnit() == gg_unit_nmsc_0409 ) or ( GetTriggerUnit() == gg_unit_nmsc_0410 ) ) )
endfunction

function Trig_nongminchulaiActions takes nothing returns nothing
    if ( ( IsUnitAliveBJ(gg_unit_nmtw_0134) == false ) and ( IsUnitAliveBJ(gg_unit_nmbg_0136) == false ) and ( IsUnitAliveBJ(gg_unit_nmsn_0133) == false ) and ( IsUnitAliveBJ(gg_unit_nmbg_0135) == false ) and ( IsUnitAliveBJ(gg_unit_nmtw_0186) == false ) and ( IsUnitAliveBJ(gg_unit_nmsc_0406) == false ) and ( IsUnitAliveBJ(gg_unit_nmsc_0408) == false ) and ( IsUnitAliveBJ(gg_unit_nmsc_0409) == false ) and ( IsUnitAliveBJ(gg_unit_nmsc_0410) == false ) ) then
        call YDWEPolledWaitNull(60.00)
        if ( ( IsUnitAliveBJ(gg_unit_ndh1_0171) == true ) ) then
            call CreateNUnitsAtLoc(1, 'n005', Player(PLAYER_NEUTRAL_PASSIVE), GetUnitLoc(gg_unit_ndh1_0171), bj_UNIT_FACING)
            set udg_cunmin=GetLastCreatedUnit()
            call AddItemToStockBJ('I00I', udg_cunmin, 1, 1)
            call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 30, "TRIGSTR_3409")
            set udg_cunmingchulai=true
        else
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_nongminchulai takes nothing returns nothing
    set gg_trg_nongminchulai=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_nongminchulai, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_nongminchulai, Condition(function Trig_nongminchulaiConditions))
    call TriggerAddAction(gg_trg_nongminchulai, function Trig_nongminchulaiActions)
endfunction

