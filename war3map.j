//***************************************************************************
//*
//*  Sounds
//*
//***************************************************************************

function InitSounds takes nothing returns nothing
    set gg_snd_ALARM8=CreateSound("ALARM8.WAV", false, false, false, 10, 10, "")
    call SetSoundDuration(gg_snd_ALARM8, 4748)
    call SetSoundChannel(gg_snd_ALARM8, 0)
    call SetSoundVolume(gg_snd_ALARM8, 127)
    call SetSoundPitch(gg_snd_ALARM8, 1.0)
    set gg_snd_tadUPD04=CreateSound("tadUPD04.wav", false, false, false, 10, 10, "")
    call SetSoundDuration(gg_snd_tadUPD04, 2239)
    call SetSoundChannel(gg_snd_tadUPD04, 0)
    call SetSoundVolume(gg_snd_tadUPD04, 127)
    call SetSoundPitch(gg_snd_tadUPD04, 1.0)
    set gg_snd_TGhLas00=CreateSound("TGhLas00.wav", false, false, false, 10, 10, "")
    call SetSoundDuration(gg_snd_TGhLas00, 2008)
    call SetSoundChannel(gg_snd_TGhLas00, 0)
    call SetSoundVolume(gg_snd_TGhLas00, 127)
    call SetSoundPitch(gg_snd_TGhLas00, 1.0)
    set gg_snd_BuildingDeathLargeHuman=CreateSound("Sound\\Buildings\\Death\\BuildingDeathLargeHuman.wav", false, true, true, 10, 10, "DefaultEAXON")
    call SetSoundParamsFromLabel(gg_snd_BuildingDeathLargeHuman, "DeathHumanLargeBuilding")
