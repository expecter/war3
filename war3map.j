//===========================================================================
// Trigger: xuexijineng2
//===========================================================================
function Trig_xuexijineng2Conditions takes nothing returns boolean
    return ( ( GetLearnedSkillBJ() == 'A0M4' ) )
endfunction

function Trig_xuexijineng2Actions takes nothing returns nothing
    if ( ( GetUnitAbilityLevelSwapped('A0M3', GetLearningUnit()) == 0 ) ) then
        call UnitAddAbilityBJ('A0M3', GetLearningUnit())
        call UnitMakeAbilityPermanent(GetLearningUnit(), true, 'A0M3')
    else
        call SetUnitAbilityLevelSwapped('A0M3', GetTriggerUnit(), ( ( GetUnitAbilityLevelSwapped('A0M4', GetTriggerUnit()) * 4 ) - 3 ))
    endif
endfunction

//===========================================================================
function InitTrig_xuexijineng2 takes nothing returns nothing
    set gg_trg_xuexijineng2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_xuexijineng2, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(gg_trg_xuexijineng2, Condition(function Trig_xuexijineng2Conditions))
    call TriggerAddAction(gg_trg_xuexijineng2, function Trig_xuexijineng2Actions)
endfunction

//===========================================================================
// Trigger: kuangre
//===========================================================================
function Trig_kuangreConditions takes nothing returns boolean
    return ( ( GetUnitAbilityLevelSwapped('A0M4', GetAttacker()) != 0 ) )
endfunction

function Trig_kuangreActions takes nothing returns nothing
    if ( ( GetUnitLifePercent(GetAttacker()) > 75.00 ) ) then
        call SetUnitAbilityLevelSwapped('A0M3', GetAttacker(), ( ( GetUnitAbilityLevelSwapped('A0M4', GetAttacker()) * 4 ) - 3 ))
    else
    endif
    if ( ( GetUnitLifePercent(GetAttacker()) <= 75.00 ) and ( GetUnitLifePercent(GetAttacker()) > 50.00 ) ) then
        call SetUnitAbilityLevelSwapped('A0M3', GetAttacker(), ( ( GetUnitAbilityLevelSwapped('A0M4', GetAttacker()) * 4 ) - 2 ))
    else
    endif
    if ( ( GetUnitLifePercent(GetAttacker()) <= 50.00 ) and ( GetUnitLifePercent(GetAttacker()) > 25.00 ) ) then
        call SetUnitAbilityLevelSwapped('A0M3', GetAttacker(), ( ( GetUnitAbilityLevelSwapped('A0M4', GetAttacker()) * 4 ) - 1 ))
    else
    endif
    if ( ( GetUnitLifePercent(GetAttacker()) <= 25.00 ) and ( GetUnitLifePercent(GetAttacker()) > 0.00 ) ) then
        call SetUnitAbilityLevelSwapped('A0M3', GetAttacker(), ( ( GetUnitAbilityLevelSwapped('A0M4', GetAttacker()) * 4 ) - 0 ))
    else
    endif
endfunction

//===========================================================================
function InitTrig_kuangre takes nothing returns nothing
    set gg_trg_kuangre=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_kuangre, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_kuangre, Condition(function Trig_kuangreConditions))
    call TriggerAddAction(gg_trg_kuangre, function Trig_kuangreActions)
endfunction

