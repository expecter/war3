    return ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B01P') == true ) )
endfunction

function Trig_beigongji2Actions takes nothing returns nothing
    if ( ( R2I(GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit())) <= ( 50 + ( 10 * GetUnitLevel(GetTriggerUnit()) ) ) ) ) then
        call AddSpecialEffectLocBJ(GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl")
        call SetUnitLifeBJ(GetTriggerUnit(), 200.00)
        call YDWEPolledWaitNull(0.30)
        call SetUnitPositionLoc(GetTriggerUnit(), GetRandomLocInRect(gg_rct______________001))
        call AddSpecialEffectLocBJ(GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")
    else
    endif
endfunction

