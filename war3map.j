function InitTrig_hecheng2 takes nothing returns nothing
    set gg_trg_hecheng2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_hecheng2, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_hecheng2, Condition(function Trig_hecheng2Conditions))
    call TriggerAddAction(gg_trg_hecheng2, function Trig_hecheng2Actions)
endfunction

