//===========================================================================
// Trigger: wushuangdaoqianghua
//
// 合成物品
//===========================================================================
function Trig_wushuangdaoqianghuaConditions takes nothing returns boolean
    return ( ( GetItemTypeId(GetManipulatedItem()) == 'I0AQ' ) )
endfunction

function Trig_wushuangdaoqianghuaActions takes nothing returns nothing
    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I07Y') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I09T') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I09S') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I09Q') == true ) ) then
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I07Y'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I09T'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I09S'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I09Q'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(GetManipulatedItem())))
        call UnitAddItemByIdSwapped('I0AO', GetTriggerUnit())
    else
        if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I0AO') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I09P') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I09W') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I09O') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I09R') == true ) ) then
            call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I0AO'))
            call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I09P'))
            call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I09W'))
            call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I09O'))
            call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I09R'))
            call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(GetManipulatedItem())))
            call UnitAddItemByIdSwapped('I0AP', GetTriggerUnit())
        else
            call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(GetManipulatedItem())))
            call AdjustPlayerStateBJ(10000, GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)
        endif
    endif
endfunction

//===========================================================================
function InitTrig_wushuangdaoqianghua takes nothing returns nothing
    set gg_trg_wushuangdaoqianghua=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_wushuangdaoqianghua, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_wushuangdaoqianghua, Condition(function Trig_wushuangdaoqianghuaConditions))
    call TriggerAddAction(gg_trg_wushuangdaoqianghua, function Trig_wushuangdaoqianghuaActions)
endfunction

