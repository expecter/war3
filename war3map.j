    set udg_jiaqian=( udg_jiaqian + 1 )
    if ( ( udg_jiaqian == 5 ) and ( IsUnitAliveBJ(udg_dianji) == true ) ) then
        call CreateItemLoc('tgxp', GetUnitLoc(udg_dianji))
        set udg_jiaqian=0
    else
    endif
    call YDWEPolledWaitNull(5.00)
    set udg_jiaqian=0
endfunction

