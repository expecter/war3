//===========================================================================
function Trig_huodewupinConditions takes nothing returns boolean
    return ( ( GetUnitTypeId(GetTriggerUnit()) == 'H011' ) )
endfunction

function Trig_huodewupinActions takes nothing returns nothing
    if ( ( ( GetItemTypeId(GetManipulatedItem()) == 'pghe' ) or ( GetItemTypeId(GetManipulatedItem()) == 'phea' ) or ( GetItemTypeId(GetManipulatedItem()) == 'hlst' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01I' ) or ( GetItemTypeId(GetManipulatedItem()) == 'pgma' ) or ( GetItemTypeId(GetManipulatedItem()) == 'sres' ) or ( GetItemTypeId(GetManipulatedItem()) == 'pres' ) or ( GetItemTypeId(GetManipulatedItem()) == 'pman' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01O' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01W' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01H' ) or ( GetItemTypeId(GetManipulatedItem()) == 'mnst' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01K' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I002' ) ) ) then
        call UnitRemoveItemSwapped(GetManipulatedItem(), GetTriggerUnit())
        call CreateTextTagLocBJ("TRIGSTR_8089", GetUnitLoc(GetTriggerUnit()), 0, 9.00, 100, 33.00, 0.00, 0)
        call SetTextTagLifespan(GetLastCreatedTextTag(), 1.00)
        call SetTextTagVelocityBJ(GetLastCreatedTextTag(), 40.00, 90)
    else
    endif
endfunction

