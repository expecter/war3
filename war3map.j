function Trig_jiuchanfazhangConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0I3' ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction

function Trig_jiuchanfazhangFunc002Func004001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) )
endfunction

function Trig_jiuchanfazhangFunc002Func004A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'e00A', GetOwningPlayer(GetTriggerUnit()), udg_chanrao, bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('A0I3', GetLastCreatedUnit())
    call IssueTargetOrder(GetLastCreatedUnit(), "entanglingroots", GetEnumUnit())
    call ShowUnitHide(GetLastCreatedUnit())
endfunction

