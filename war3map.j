//===========================================================================
// Trigger: quntishenshenghujia
//===========================================================================
function Trig_quntishenshenghujiaConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A08Z' ) )
endfunction

function Trig_quntishenshenghujiaActions takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'h00G', GetTriggerPlayer(), GetSpellTargetLoc(), bj_UNIT_FACING)
    set udg_quntishenshenghujia[GetConvertedPlayerId(GetTriggerPlayer())]=GetLastCreatedUnit()
    call YDWEPolledWaitNull(45.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(udg_quntishenshenghujia[GetConvertedPlayerId(GetTriggerPlayer())], 100, 100.00, 100.00, ( 0.00 + ( 10.00 * I2R(GetForLoopIndexA()) ) ))
        call YDWEPolledWaitNull(0.20)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call RemoveUnit(udg_quntishenshenghujia[GetConvertedPlayerId(GetTriggerPlayer())])
endfunction

//===========================================================================
function InitTrig_quntishenshenghujia takes nothing returns nothing
    set gg_trg_quntishenshenghujia=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_quntishenshenghujia, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_quntishenshenghujia, Condition(function Trig_quntishenshenghujiaConditions))
    call TriggerAddAction(gg_trg_quntishenshenghujia, function Trig_quntishenshenghujiaActions)
endfunction

