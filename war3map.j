//===========================================================================
// Trigger: shendebaohu
//===========================================================================
function Trig_shendebaohuConditions takes nothing returns boolean
    return ( ( GetResearched() == 'R002' ) )
endfunction

function Trig_shendebaohuActions takes nothing returns nothing
    if ( ( GetPlayerTechCountSimple('R002', GetTriggerPlayer()) == 1 ) ) then
        call UnitAddAbilityBJ('A0HX', GetTriggerUnit())
    else
    endif
    if ( ( GetPlayerTechCountSimple('R002', GetTriggerPlayer()) == 2 ) ) then
        call IncUnitAbilityLevelSwapped('A0HX', GetTriggerUnit())
    else
    endif
    if ( ( GetPlayerTechCountSimple('R002', GetTriggerPlayer()) == 3 ) ) then
        call IncUnitAbilityLevelSwapped('A0HX', GetTriggerUnit())
    else
    endif
    if ( ( GetPlayerTechCountSimple('R002', GetTriggerPlayer()) == 4 ) ) then
        call IncUnitAbilityLevelSwapped('A0HX', GetTriggerUnit())
    else
    endif
    set udg_fangjiantaweizhi=GetTriggerUnit()
endfunction

//===========================================================================
function InitTrig_shendebaohu takes nothing returns nothing
    set gg_trg_shendebaohu=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_shendebaohu, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_shendebaohu, Condition(function Trig_shendebaohuConditions))
    call TriggerAddAction(gg_trg_shendebaohu, function Trig_shendebaohuActions)
endfunction

