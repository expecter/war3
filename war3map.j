function InitTrig_changuangxia takes nothing returns nothing
    set gg_trg_changuangxia=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_changuangxia, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_changuangxia, Condition(function Trig_changuangxiaConditions))
    call TriggerAddAction(gg_trg_changuangxia, function Trig_changuangxiaActions)
endfunction

//===========================================================================
// Trigger: dadizhenji
//===========================================================================
function Trig_dadizhenjiConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0IS' ) )
endfunction

function Trig_dadizhenjiFunc018001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) )
endfunction

function Trig_dadizhenjiFunc018A takes nothing returns nothing
    call UnitDamageTarget(GetTriggerUnit(), GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) * 2.00 ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("origin", GetEnumUnit(), "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

function Trig_dadizhenjiActions takes nothing returns nothing
    set udg_zhanlongjue2=GetUnitLoc(GetTriggerUnit())
    call YDWEPolledWaitNull(0.10)
    call PauseUnitBJ(true, GetTriggerUnit())
    call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call SetUnitInvulnerable(GetTriggerUnit(), true)
    call CreateNUnitsAtLoc(1, 'npn3', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    set udg_dadi[GetConvertedPlayerId(GetTriggerPlayer())]=GetLastCreatedUnit()
    call PauseUnitBJ(true, udg_dadi[GetConvertedPlayerId(GetTriggerPlayer())])
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(udg_dadi[GetConvertedPlayerId(GetTriggerPlayer())], 100, 100, 100, ( 80.00 - ( 10.00 * I2R(GetForLoopIndexA()) ) ))
        call YDWEPolledWaitNull(0.10)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitAnimation(udg_dadi[GetConvertedPlayerId(GetTriggerPlayer())], "attack slam")
    call AddSpecialEffectTargetUnitBJ("origin", udg_dadi[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call AddSpecialEffectTargetUnitBJ("origin", udg_dadi[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call ShowUnitHide(GetTriggerUnit())
    call YDWEPolledWaitNull(0.30)
    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(700.00 , GetUnitLoc(GetLastCreatedUnit()) , Condition(function Trig_dadizhenjiFunc018001003)), function Trig_dadizhenjiFunc018A)
    call SetUnitVertexColor(GetTriggerUnit(), 100, 0, 0, 255)
    call SetUnitManaPercentBJ(GetTriggerUnit(), 0.00)
    call DestroyGroup(GetLastCreatedGroup())
    call YDWEPolledWaitNull(1.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(udg_dadi[GetConvertedPlayerId(GetTriggerPlayer())], 100, 100, 100, ( 50.00 + ( 10.00 * I2R(GetForLoopIndexA()) ) ))
        call YDWEPolledWaitNull(0.10)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call RemoveUnit(udg_dadi[GetConvertedPlayerId(GetTriggerPlayer())])
    call ShowUnitShow(GetTriggerUnit())
    call PauseUnitBJ(false, GetTriggerUnit())
    call SetUnitInvulnerable(GetTriggerUnit(), false)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(GetTriggerUnit(), 100, ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), 0.00)
        call YDWEPolledWaitNull(0.30)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitVertexColor(GetTriggerUnit(), 255, 255, 255, 255)
    call RemoveLocation(udg_zhanlongjue2)
endfunction

//===========================================================================
function InitTrig_dadizhenji takes nothing returns nothing
    set gg_trg_dadizhenji=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_dadizhenji, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_dadizhenji, Condition(function Trig_dadizhenjiConditions))
    call TriggerAddAction(gg_trg_dadizhenji, function Trig_dadizhenjiActions)
endfunction

