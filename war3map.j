//===========================================================================
// Trigger: yingxionghuigui
//===========================================================================
function Trig_yingxionghuiguiConditions takes nothing returns boolean
    return ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B02B') == true ) and ( R2I(GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit())) < ( 50 + ( 10 * GetUnitLevel(GetTriggerUnit()) ) ) ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(gg_unit_H001_0524))) > 3000 ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'BOhx') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B00C') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'BSTN') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'BPSE') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B00D') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01L') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'Bply') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'BEer') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B01A') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'BUim') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'Bprg') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'Bstt') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'BCbf') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'BNin') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B00A') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'BNcs') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'BIwb') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'Bmlt') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'Bens') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'Beng') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B02J') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B02K') == false ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B03R') == false ) )
endfunction

function Trig_yingxionghuiguiActions takes nothing returns nothing
    call AddSpecialEffectLocBJ(GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call AddSpecialEffectLocBJ(GetUnitLoc(gg_unit_H001_0524), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call SetUnitPositionLoc(GetTriggerUnit(), GetRandomLocInRect(gg_rct______________009))
    call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 30, "TRIGSTR_5648")
    call YDWEPolledWaitNull(2)
    if ( ( IsUnitAliveBJ(GetTriggerUnit()) == true ) ) then
        call SetUnitLifePercentBJ(GetTriggerUnit(), 70.00)
        call AddHeroXPSwapped(( ( udg_jingyanzhifujia + 10 ) * GetUnitLevel(GetTriggerUnit()) ), GetTriggerUnit(), true)
    else
    endif
endfunction

