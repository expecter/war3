// Trigger: qilinjian gongji
//===========================================================================
function Trig_qilinjian_gongjiConditions takes nothing returns boolean
    return ( ( UnitHasItemOfTypeBJ(GetAttacker(), 'I06L') == true ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(GetTriggerUnit()))) <= 280 ) and ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetAttacker(), 'I06L')) > 0 ) and ( IsUnitIllusionBJ(GetAttacker()) == false ) )
endfunction

function Trig_qilinjian_gongjiActions takes nothing returns nothing
    call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), ( 30.00 * I2R(GetItemCharges(GetItemOfTypeFromUnitBJ(GetAttacker(), 'I06L'))) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    if ( ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetAttacker(), 'I06L')) > 5 ) ) then
        call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl")
    else
        call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl")
    endif
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

