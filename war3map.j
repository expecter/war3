// Trigger: fantanshanghai
//===========================================================================
function Trig_fantanshanghaiConditions takes nothing returns boolean
    return ( ( UnitHasBuffBJ(GetTriggerUnit(), 'Bbsk') == true ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(GetTriggerUnit()))) <= 260 ) and ( ( GetUnitTypeId(GetTriggerUnit()) == 'O00P' ) or ( GetUnitTypeId(GetTriggerUnit()) == 'O00T' ) ) )
endfunction

function Trig_fantanshanghaiActions takes nothing returns nothing
    call UnitDamageTarget(GetTriggerUnit(), GetAttacker(), ( ( 15.00 * I2R(GetUnitAbilityLevelSwapped('A0M5', GetTriggerUnit())) ) + ( ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ) / ( 100.00 - ( I2R(GetUnitAbilityLevelSwapped('A0M5', GetTriggerUnit())) * 10.00 ) ) ) ), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("origin", GetAttacker(), "Abilities\\Spells\\Other\\Cleave\\CleaveDamageTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

//===========================================================================
function InitTrig_fantanshanghai takes nothing returns nothing
    set gg_trg_fantanshanghai=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_fantanshanghai, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_fantanshanghai, Condition(function Trig_fantanshanghaiConditions))
