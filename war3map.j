    call YDWEPolledWaitNull(0.20)
    call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), 200.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

