function Trig_quntishengguangxuexiConditions takes nothing returns boolean
    return ( ( GetUnitLevel(GetTriggerUnit()) == 12 ) and ( GetUnitTypeId(GetTriggerUnit()) == 'Hpal' ) )
endfunction

function Trig_quntishengguangxuexiActions takes nothing returns nothing
    call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 30, "TRIGSTR_031")
endfunction

//===========================================================================
function InitTrig_quntishengguangxuexi takes nothing returns nothing
    set gg_trg_quntishengguangxuexi=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_quntishengguangxuexi, EVENT_PLAYER_HERO_LEVEL)
    call TriggerAddCondition(gg_trg_quntishengguangxuexi, Condition(function Trig_quntishengguangxuexiConditions))
    call TriggerAddAction(gg_trg_quntishengguangxuexi, function Trig_quntishengguangxuexiActions)
endfunction

//===========================================================================
// Trigger: shengguang
//===========================================================================
function Trig_shengguangConditions takes nothing returns boolean
    return ( ( ( GetSpellAbilityId() == 'AHhb' ) or ( GetSpellAbilityId() == 'A096' ) or ( GetSpellAbilityId() == 'A072' ) or ( GetSpellAbilityId() == 'A00E' ) ) )
endfunction

function Trig_shengguangActions takes nothing returns nothing
    if ( ( ( GetUnitTypeId(GetSpellTargetUnit()) == 'N00S' ) ) ) then
        call SetUnitLifeBJ(GetSpellTargetUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) / 4.00 ))
        call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 10.00, "TRIGSTR_3422")
    else
    endif
endfunction

//===========================================================================
function InitTrig_shengguang takes nothing returns nothing
    set gg_trg_shengguang=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_shengguang, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_shengguang, Condition(function Trig_shengguangConditions))
    call TriggerAddAction(gg_trg_shengguang, function Trig_shengguangActions)
endfunction

//===========================================================================
// Trigger: arsah
//===========================================================================
function Trig_arsahConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A096' ) and ( R2I(GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit())) >= 165 ) and ( ( GetUnitTypeId(GetTriggerUnit()) == 'H00U' ) or ( GetUnitTypeId(GetTriggerUnit()) == 'H00Y' ) ) and ( ( GetSpellAbilityId() == 'AHhb' ) or ( GetSpellAbilityId() == 'A096' ) ) )
endfunction

function Trig_arsahFunc002A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'e00A', GetOwningPlayer(GetTriggerUnit()), udg_quntishengguang, bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('A096', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('A096', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A096', GetTriggerUnit()))
    call IssueTargetOrder(GetLastCreatedUnit(), "holybolt", GetEnumUnit())
    call ShowUnitHide(GetLastCreatedUnit())
endfunction

function Trig_arsahActions takes nothing returns nothing
    set udg_quntishengguang=GetUnitLoc(GetSpellTargetUnit())
    call ForGroupBJ((YDWEGetUnitsInRangeOfLocMatchingNull(((( I2R(GetUnitLevel(GetTriggerUnit())) * 65.00 ) )*1.0) , ( udg_quntishengguang) , null)), function Trig_arsahFunc002A) // INLINED!!
    call DestroyGroup(GetLastCreatedGroup())
    call SetUnitManaBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - 100.00 ))
    call RemoveUnit(GetLastCreatedUnit())
    call RemoveLocation(udg_quntishengguang)
endfunction

//===========================================================================
function InitTrig_arsah takes nothing returns nothing
    set gg_trg_arsah=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_arsah, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_arsah, Condition(function Trig_arsahConditions))
    call TriggerAddAction(gg_trg_arsah, function Trig_arsahActions)
endfunction

