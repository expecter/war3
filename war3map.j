//===========================================================================
function Trig_moshenConditions takes nothing returns boolean
    return ( ( GetUnitTypeId(GetTriggerUnit()) == 'U002' ) and ( GetPlayerController(GetTriggerPlayer()) != MAP_CONTROL_USER ) )
endfunction

function Trig_moshenActions takes nothing returns nothing
    call YDWEPolledWaitNull(120.00)
    call ReviveHeroLoc(GetTriggerUnit(), GetPlayerStartLocationLoc(GetTriggerPlayer()), true)
    call SetHeroLevelBJ(GetTriggerUnit(), ( GetUnitLevel(GetTriggerUnit()) + 1 ), true)
endfunction

//===========================================================================
function InitTrig_moshen takes nothing returns nothing
    set gg_trg_moshen=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_moshen, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_moshen, Condition(function Trig_moshenConditions))
    call TriggerAddAction(gg_trg_moshen, function Trig_moshenActions)
endfunction

//===========================================================================
// Trigger: beigongji
//===========================================================================
function Trig_beigongjiConditions takes nothing returns boolean
    return ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I018') == true ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction

function Trig_beigongjiActions takes nothing returns nothing
    if ( ( GetUnitLevel(GetTriggerUnit()) < 15 ) ) then
        call AddHeroXPSwapped(10, GetTriggerUnit(), true)
        call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetOwningPlayer(GetTriggerUnit())), 2.00, ( "|cffffcc00EXP + 10" ))
    else
    endif
    call SetUnitLifeBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + 5.00 ))
    call SetUnitManaBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + 1.00 ))
endfunction

//===========================================================================
function InitTrig_beigongji takes nothing returns nothing
    set gg_trg_beigongji=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_beigongji, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_beigongji, Condition(function Trig_beigongjiConditions))
    call TriggerAddAction(gg_trg_beigongji, function Trig_beigongjiActions)
endfunction

//===========================================================================
// Trigger: shuangdongshendian
//===========================================================================
function Trig_shuangdongshendianConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A092' ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I018') == true ) )
endfunction

function Trig_shuangdongshendianFunc001001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) )
endfunction

function Trig_shuangdongshendianFunc001A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'n012', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('A092', GetLastCreatedUnit())
    call IssueTargetOrder(GetLastCreatedUnit(), "thunderbolt", GetEnumUnit())
    call ShowUnitHide(GetLastCreatedUnit())
endfunction

function Trig_shuangdongshendianActions takes nothing returns nothing
    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(350.00 , GetSpellTargetLoc() , Condition(function Trig_shuangdongshendianFunc001001003)), function Trig_shuangdongshendianFunc001A)
    call DestroyGroup(GetLastCreatedGroup())
endfunction

//===========================================================================
function InitTrig_shuangdongshendian takes nothing returns nothing
    set gg_trg_shuangdongshendian=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_shuangdongshendian, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_shuangdongshendian, Condition(function Trig_shuangdongshendianConditions))
    call TriggerAddAction(gg_trg_shuangdongshendian, function Trig_shuangdongshendianActions)
endfunction

//===========================================================================
// Trigger: yuexiakuangxiangqu
//===========================================================================
function Trig_yuexiakuangxiangquConditions takes nothing returns boolean
    return ( ( GetUnitAbilityLevelSwapped('A066', GetAttacker()) > 0 ) )
endfunction

function Trig_yuexiakuangxiangquFunc001002003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetAttacker())) == true ) )
endfunction

function Trig_yuexiakuangxiangquFunc002Func006001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetAttacker())) == true ) )
endfunction

function Trig_yuexiakuangxiangquFunc002Func006A takes nothing returns nothing
    call UnitDamageTarget(GetAttacker(), GetEnumUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, GetAttacker(), true)) * I2R(GetUnitAbilityLevelSwapped('A066', GetAttacker())) ), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("chest", GetEnumUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

function Trig_yuexiakuangxiangquActions takes nothing returns nothing
    set udg_Blink_Storm_Targets[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]=YDWEGetUnitsInRangeOfLocMatchingNull(220.00 , GetUnitLoc(GetAttacker()) , Condition(function Trig_yuexiakuangxiangquFunc001002003))
    if ( ( GetRandomInt(1, 6) == 3 ) and ( IsUnitGroupEmptyBJ(udg_Blink_Storm_Targets[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]) == false ) ) then
        call SetUnitAnimation(GetAttacker(), "Spell Slam")
        call AddSpecialEffectTargetUnitBJ("weapon", GetAttacker(), "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(200.00 , GetUnitLoc(GetAttacker()) , Condition(function Trig_yuexiakuangxiangquFunc002Func006001003)), function Trig_yuexiakuangxiangquFunc002Func006A)
    else
    endif
endfunction

//===========================================================================
function InitTrig_yuexiakuangxiangqu takes nothing returns nothing
    set gg_trg_yuexiakuangxiangqu=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_yuexiakuangxiangqu, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_yuexiakuangxiangqu, Condition(function Trig_yuexiakuangxiangquConditions))
    call TriggerAddAction(gg_trg_yuexiakuangxiangqu, function Trig_yuexiakuangxiangquActions)
endfunction

//===========================================================================
// Trigger: bishouyu
//===========================================================================
function Trig_bishouyuConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0DA' ) )
endfunction

function Trig_bishouyuFunc012001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) )
endfunction

function Trig_bishouyuFunc012A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'e00A', GetOwningPlayer(GetTriggerUnit()), udg_bishouyu[GetConvertedPlayerId(GetTriggerPlayer())], bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(5.00, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('AEsh', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('AEsh', GetLastCreatedUnit(), ( GetUnitLevel(GetTriggerUnit()) / 3 ))
    call IssueTargetOrder(GetLastCreatedUnit(), "shadowstrike", GetEnumUnit())
    call ShowUnitHide(GetLastCreatedUnit())
endfunction

function Trig_bishouyuActions takes nothing returns nothing
    set udg_bishouyu[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetLoc()
    set udg_bishouyu2[GetConvertedPlayerId(GetTriggerPlayer())]=GetUnitLoc(GetTriggerUnit())
    call YDWEPolledWaitNull(0.10)
    call SetUnitAnimation(GetTriggerUnit(), "spell slam")
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call SetUnitInvulnerable(GetTriggerUnit(), true)
    call SetUnitPositionLoc(GetTriggerUnit(), udg_bishouyu[GetConvertedPlayerId(GetTriggerPlayer())])
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call YDWEPolledWaitNull(0.10)
    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(400.00 , udg_bishouyu[GetConvertedPlayerId(GetTriggerPlayer())] , Condition(function Trig_bishouyuFunc012001003)), function Trig_bishouyuFunc012A)
    call SetUnitAnimation(GetTriggerUnit(), "spell slam")
    call AddSpecialEffectTargetUnitBJ("weapon", GetTriggerUnit(), "Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call YDWEPolledWaitNull(0.30)
    call UnitAddAbilityBJ('AEfk', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('AEfk', GetLastCreatedUnit(), ( GetUnitLevel(GetTriggerUnit()) / 3 ))
    call IssueImmediateOrder(GetLastCreatedUnit(), "fanofknives")
    call SetUnitAnimation(GetTriggerUnit(), "spell slam")
    call SetUnitAnimationByIndex(GetTriggerUnit(), 1)
    call YDWEPolledWaitNull(2.00)
    call SetUnitInvulnerable(GetTriggerUnit(), false)
endfunction

//===========================================================================
function InitTrig_bishouyu takes nothing returns nothing
    set gg_trg_bishouyu=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_bishouyu, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_bishouyu, Condition(function Trig_bishouyuConditions))
    call TriggerAddAction(gg_trg_bishouyu, function Trig_bishouyuActions)
endfunction

//===========================================================================
// Trigger: yuewuyuanshazhen
//===========================================================================
function Trig_yuewuyuanshazhenConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A055' ) )
endfunction

function Trig_yuewuyuanshazhenActions takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'n012', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    call ShowUnitHide(GetLastCreatedUnit())
    call UnitAddAbilityBJ('A0CO', GetLastCreatedUnit())
    call IssueImmediateOrderById(GetLastCreatedUnit(), 852621)
    call RemoveUnit(GetLastCreatedUnit())
    call SetUnitInvulnerable(GetTriggerUnit(), true)
    call PauseUnitBJ(true, GetTriggerUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=30
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(GetTriggerUnit(), 100, 100, 100, ( 0.00 + ( 10.00 * I2R(GetForLoopIndexA()) ) ))
        call SetUnitAnimation(GetTriggerUnit(), "spell slam")
        call YDWEPolledWaitNull(0.20)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitInvulnerable(GetTriggerUnit(), false)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(GetTriggerUnit(), 100, 100, 100, ( 100.00 - ( 10.00 * I2R(GetForLoopIndexA()) ) ))
        call SetUnitAnimation(GetTriggerUnit(), "spell slam")
        call YDWEPolledWaitNull(0.20)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call PauseUnitBJ(false, GetTriggerUnit())
endfunction

//===========================================================================
function InitTrig_yuewuyuanshazhen takes nothing returns nothing
    set gg_trg_yuewuyuanshazhen=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_yuewuyuanshazhen, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_yuewuyuanshazhen, Condition(function Trig_yuewuyuanshazhenConditions))
    call TriggerAddAction(gg_trg_yuewuyuanshazhen, function Trig_yuewuyuanshazhenActions)
endfunction

