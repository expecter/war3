//===========================================================================
// Trigger: siwangqiyue
//===========================================================================
function Trig_siwangqiyueConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'AUdp' ) )
endfunction

function Trig_siwangqiyueActions takes nothing returns nothing
    call UnitAddAbilityBJ('A0Q0', GetTriggerUnit())
    call SetUnitVertexColorBJ(GetTriggerUnit(), 100, 0.00, 0.00, 0.00)
    call YDWEPolledWaitNull(( 4.00 * I2R(GetUnitAbilityLevelSwapped('AUdp', GetTriggerUnit())) ))
    call UnitRemoveAbilityBJ('A0Q0', GetTriggerUnit())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(GetTriggerUnit(), 100, ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), 0.00)
        call YDWEPolledWaitNull(0.20)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitVertexColorBJ(GetTriggerUnit(), 100, 100.00, 100.00, 0.00)
endfunction

//===========================================================================
function InitTrig_siwangqiyue takes nothing returns nothing
    set gg_trg_siwangqiyue=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_siwangqiyue, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_siwangqiyue, Condition(function Trig_siwangqiyueConditions))
    call TriggerAddAction(gg_trg_siwangqiyue, function Trig_siwangqiyueActions)
endfunction

