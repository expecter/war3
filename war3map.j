//===========================================================================
// Trigger: washenjianglin
//===========================================================================
function Trig_washenjianglinConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0KO' ) )
endfunction

function Trig_washenjianglinActions takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'h018', GetTriggerPlayer(), GetSpellTargetLoc(), bj_UNIT_FACING)
    set udg_senlinguanghuan[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetLoc()
    set udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())]=GetLastCreatedUnit()
    call IssueImmediateOrder(udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())], "voodoo")
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())], 100, 100.00, 100.00, ( 100.00 - ( 5.00 * I2R(GetForLoopIndexA()) ) ))
        call YDWEPolledWaitNull(0.10)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call YDWEPolledWaitNull(37.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())], 100, 100.00, 100.00, ( 0.00 + ( 10.00 * I2R(GetForLoopIndexA()) ) ))
        call YDWEPolledWaitNull(0.20)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call RemoveUnit(udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())])
    call RemoveLocation(udg_senlinguanghuan[GetConvertedPlayerId(GetTriggerPlayer())])
endfunction

//===========================================================================
function InitTrig_washenjianglin takes nothing returns nothing
    set gg_trg_washenjianglin=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_washenjianglin, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_washenjianglin, Condition(function Trig_washenjianglinConditions))
    call TriggerAddAction(gg_trg_washenjianglin, function Trig_washenjianglinActions)
endfunction

