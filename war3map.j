    set gg_trg_chicao=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_chicao, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_chicao, Condition(function Trig_chicaoConditions))
