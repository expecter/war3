function InitTrig_shayingxiong takes nothing returns nothing
    set gg_trg_shayingxiong=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_shayingxiong, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_shayingxiong, Condition(function Trig_shayingxiongConditions))
    call TriggerAddAction(gg_trg_shayingxiong, function Trig_shayingxiongActions)
endfunction

