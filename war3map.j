function Trig_koudaigongchang21Conditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'ANs2' ) )
endfunction

function Trig_koudaigongchang21Actions takes nothing returns nothing
    if ( ( GetUnitAbilityLevelSwapped('ANs2', GetTriggerUnit()) == 2 ) ) then
        call CreateNUnitsAtLoc(1, 'n012', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
        call UnitAddAbilityBJ('A0DF', GetLastCreatedUnit())
        call IssuePointOrderLoc(GetLastCreatedUnit(), "summonfactory", PolarProjectionBJ(GetSpellTargetLoc(), 100.00, GetRandomDirectionDeg()))
        call RemoveUnit(GetLastCreatedUnit())
    else
        if ( ( GetUnitAbilityLevelSwapped('ANs2', GetTriggerUnit()) == 3 ) ) then
            call CreateNUnitsAtLoc(1, 'n012', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
            call UnitApplyTimedLifeBJ(3.00, 'BTLF', GetLastCreatedUnit())
            call UnitAddAbilityBJ('A0DF', GetLastCreatedUnit())
            call IssuePointOrderLoc(GetLastCreatedUnit(), "summonfactory", PolarProjectionBJ(GetSpellTargetLoc(), 150.00, GetRandomDirectionDeg()))
        else
        endif
    endif
endfunction

//===========================================================================
function InitTrig_koudaigongchang21 takes nothing returns nothing
    set gg_trg_koudaigongchang21=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_koudaigongchang21, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_koudaigongchang21, Condition(function Trig_koudaigongchang21Conditions))
    call TriggerAddAction(gg_trg_koudaigongchang21, function Trig_koudaigongchang21Actions)
endfunction

