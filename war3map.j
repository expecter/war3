//===========================================================================
// Trigger: leishenzhichui
//===========================================================================
function Trig_leishenzhichuiConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0KH' ) and ( UnitHasBuffBJ(GetTriggerUnit(), 'B009') == true ) )
endfunction

function Trig_leishenzhichuiFunc004001 takes nothing returns boolean
    return ( ( ( UnitHasBuffBJ(udg_leishenzhichui[GetConvertedPlayerId(GetTriggerPlayer())], 'BPSE') == true ) or ( IsUnitDeadBJ(udg_leishenzhichui[GetConvertedPlayerId(GetTriggerPlayer())]) == true ) ) )
endfunction

function Trig_leishenzhichuiFunc007001003 takes nothing returns boolean
    return ( ( ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true ) and ( ( IsUnitAliveBJ(GetFilterUnit()) == true ) and ( GetFilterUnit() != udg_leishenzhichui[GetConvertedPlayerId(GetTriggerPlayer())] ) ) ) )
endfunction

function Trig_leishenzhichuiFunc007A takes nothing returns nothing
    call UnitDamageTarget(GetTriggerUnit(), GetEnumUnit(), ( 100.00 * I2R(GetUnitAbilityLevelSwapped('A0KH', GetTriggerUnit())) ), true, true, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_SONIC, WEAPON_TYPE_METAL_HEAVY_CHOP)
    call AddSpecialEffectTargetUnitBJ("origin", GetEnumUnit(), "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

function Trig_leishenzhichuiActions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ("weapon", GetTriggerUnit(), "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    set udg_leishenzhichui[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetUnit()
    loop
        exitwhen ( (( UnitHasBuffBJ(udg_leishenzhichui[GetConvertedPlayerId(GetTriggerPlayer())], 'BPSE') == true ) or ( IsUnitDeadBJ(udg_leishenzhichui[GetConvertedPlayerId(GetTriggerPlayer())]) == true )) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    call AddSpecialEffectTargetUnitBJ("origin", udg_leishenzhichui[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(( 90.00 * I2R(GetUnitAbilityLevelSwapped('A0KI', GetTriggerUnit())) ) , GetUnitLoc(udg_leishenzhichui[GetConvertedPlayerId(GetTriggerPlayer())]) , Condition(function Trig_leishenzhichuiFunc007001003)), function Trig_leishenzhichuiFunc007A)
endfunction

//===========================================================================
function InitTrig_leishenzhichui takes nothing returns nothing
    set gg_trg_leishenzhichui=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_leishenzhichui, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_leishenzhichui, Condition(function Trig_leishenzhichuiConditions))
    call TriggerAddAction(gg_trg_leishenzhichui, function Trig_leishenzhichuiActions)
endfunction

