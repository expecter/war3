endfunction

function Trig_senlinguanghuanActions takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'h00H', GetTriggerPlayer(), GetSpellTargetLoc(), bj_UNIT_FACING)
    set udg_senlinguanghuan[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetLoc()
    set udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())]=GetLastCreatedUnit()
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())], 100, 100.00, 100.00, ( 100.00 - ( 10.00 * I2R(GetForLoopIndexA()) ) ))
        call YDWEPolledWaitNull(0.10)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call UnitAddAbilityBJ('A089', udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())])
    call SetUnitAbilityLevelSwapped('A089', udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())], GetUnitAbilityLevelSwapped('A093', GetTriggerUnit()))
    call IssueImmediateOrder(udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())], "tranquility")
    call YDWEPolledWaitNull(30.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())], 100, 100.00, 100.00, ( 0.00 + ( 10.00 * I2R(GetForLoopIndexA()) ) ))
        call YDWEPolledWaitNull(0.20)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call RemoveUnit(udg_senlinguanghuan2[GetConvertedPlayerId(GetTriggerPlayer())])
    call RemoveLocation(udg_senlinguanghuan[GetConvertedPlayerId(GetTriggerPlayer())])
endfunction

