function Trig_dashejiandazhaoActions takes nothing returns nothing
    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I06U') == true ) and ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I065') == true ) or ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I067') == true ) ) ) then
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I065'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I067'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I06U'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(GetManipulatedItem())))
        call UnitAddItemByIdSwapped('I06S', GetTriggerUnit())
    else
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(GetManipulatedItem())))
        call AdjustPlayerStateBJ(5000, GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)
    endif
endfunction

