//===========================================================================
// Trigger: chunci anolake
//===========================================================================
function Trig_chunci_anolakeConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'AUim' ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) and ( GetUnitTypeId(GetTriggerUnit()) == 'U002' ) )
endfunction

function Trig_chunci_anolakeActions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'e00A', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
        call UnitAddAbilityBJ('AUim', GetLastCreatedUnit())
        call SetUnitAbilityLevelSwapped('AUim', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('AUim', GetTriggerUnit()))
        call IssuePointOrderLoc(GetLastCreatedUnit(), "impale", PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 256, ( 60.00 * I2R(GetForLoopIndexA()) )))
        call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call ShowUnitHide(GetLastCreatedUnit())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_chunci_anolake takes nothing returns nothing
    set gg_trg_chunci_anolake=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_chunci_anolake, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_chunci_anolake, Condition(function Trig_chunci_anolakeConditions))
    call TriggerAddAction(gg_trg_chunci_anolake, function Trig_chunci_anolakeActions)
endfunction

