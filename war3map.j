// Trigger: anshadao gongji
//===========================================================================
function Trig_anshadao_gongjiConditions takes nothing returns boolean
    return ( ( UnitHasItemOfTypeBJ(GetAttacker(), 'I074') == true ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(GetTriggerUnit()))) <= 300 ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false ) and ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetAttacker(), 'I074')) > 0 ) and ( IsUnitIllusionBJ(GetAttacker()) == false ) )
endfunction

function Trig_anshadao_gongjiActions takes nothing returns nothing
    if ( ( GetUnitFacing(GetTriggerUnit()) >= ( GetUnitFacing(GetAttacker()) - 60.00 ) ) and ( GetUnitFacing(GetTriggerUnit()) <= ( GetUnitFacing(GetAttacker()) + 60.00 ) ) ) then
        call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), ( 60.00 * I2R(GetItemCharges(GetItemOfTypeFromUnitBJ(GetAttacker(), 'I074'))) ), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodKnight.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call UnitRemoveBuffBJ('BOwk', GetAttacker())
    else
        call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
    endif
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

