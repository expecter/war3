//
// 合成物品
//===========================================================================
function Trig_xueyinzhuConditions takes nothing returns boolean
    return ( ( GetItemTypeId(GetManipulatedItem()) == 'I08G' ) )
endfunction

function Trig_xueyinzhuActions takes nothing returns nothing
    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I08D') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I04W') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'modt') == true ) ) then
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'modt'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I08D'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I04W'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(GetManipulatedItem())))
        call UnitAddItemByIdSwapped('I08F', GetTriggerUnit())
    else
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(GetManipulatedItem())))
        call AdjustPlayerStateBJ(3500, GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)
    endif
endfunction

