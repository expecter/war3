//===========================================================================
// Trigger: wanjia1
//
// 双击选英雄要处理的触发是最少的，恩且无论多少英雄都可以用同一个触发，用改变所有者并移动单位的方式提供英雄，就可以解决英雄被重复选择的问题；把玩家添加到已经选择的玩家组，可以避免玩家重复选英雄。
// 原理：用选择单位事件，判断两次选择事件是否小于0.2秒，是则为双击，改变单位所有者并移动单位。
//===========================================================================
function Trig_wanjia1Conditions takes nothing returns boolean
    return ( ( RectContainsUnit(gg_rct______________000, GetTriggerUnit()) == true ) )
endfunction

function Trig_wanjia1Actions takes nothing returns nothing
    if ( ( udg_shuangji < 2 ) ) then
        // 记录点击次数
        set udg_shuangji=( udg_shuangji + 1 )
    else
    endif
    if ( ( udg_shuangji == 2 ) and ( IsPlayerInForce(GetTriggerPlayer(), udg_yixuan) == false ) ) then
        call SetUnitOwner(GetTriggerUnit(), GetTriggerPlayer(), true)
        call SetUnitPositionLoc(GetTriggerUnit(), GetRectCenter(gg_rct______________001))
        call PanCameraToTimedLocForPlayer(GetTriggerPlayer(), GetRectCenter(gg_rct______________001), 0)
        call ForceAddPlayerSimple(GetTriggerPlayer(), udg_yixuan)
    else
    endif
endfunction

//===========================================================================
function InitTrig_wanjia1 takes nothing returns nothing
    set gg_trg_wanjia1=CreateTrigger()
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_wanjia1, Player(0), true)
    call TriggerAddCondition(gg_trg_wanjia1, Condition(function Trig_wanjia1Conditions))
    call TriggerAddAction(gg_trg_wanjia1, function Trig_wanjia1Actions)
endfunction

