function Trig_yizhan2Actions takes nothing returns nothing
    set udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetUnit()
    set udg_yishanweizhi=GetUnitLoc(GetTriggerUnit())
    set udg_yishantexiao=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl", GetTriggerUnit(), "chest")
    call SetUnitAnimation(GetTriggerUnit(), "attack slam")
    call YDWEPolledWaitNull(0.40)
    call SetUnitPositionLoc(GetTriggerUnit(), PolarProjectionBJ(udg_yishanweizhi, ( DistanceBetweenPoints(udg_yishanweizhi, GetUnitLoc(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())])) + 10.00 ), AngleBetweenPoints(udg_yishanweizhi, GetUnitLoc(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())]))))
    call AddSpecialEffectTargetUnitBJ("chest", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    call YDWEPolledWaitNull(0.40)
    call DestroyEffect(udg_yishantexiao)
    call RemoveLocation(udg_yishanweizhi)
