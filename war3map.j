//===========================================================================
// Trigger: kuanghua
//===========================================================================
function Trig_kuanghuaConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0CB' ) )
endfunction

function Trig_kuanghuaActions takes nothing returns nothing
    call AddSpecialEffectLocBJ(GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl")
    call SetUnitVertexColor(GetTriggerUnit(), 255, 0, 0, 255)
    call DestroyEffect(GetLastCreatedEffectBJ())
    call ModifyHeroStat(bj_HEROSTAT_AGI, GetTriggerUnit(), bj_MODIFYMETHOD_ADD, 70)
    call SetUnitMoveSpeed(GetTriggerUnit(), 1000.00)
    call UnitAddAbilityBJ('A06A', GetTriggerUnit())
    call CreateTextTagLocBJ("TRIGSTR_024", GetUnitLoc(GetTriggerUnit()), ( 80.00 + ( 10.00 * I2R(GetForLoopIndexA()) ) ), 10, 100, 0.00, 0.00, 0)
    call SetTextTagVelocityBJ(GetLastCreatedTextTag(), 32.00, 90)
    call YDWEPolledWaitNull(1.00)
    call DestroyTextTag(GetLastCreatedTextTag())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(GetTriggerUnit(), 100, ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), 0.00)
        call YDWEPolledWaitNull(3.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call YDWEPolledWaitNull(4.00)
    call ModifyHeroStat(bj_HEROSTAT_AGI, GetTriggerUnit(), bj_MODIFYMETHOD_SUB, 70)
    call SetUnitVertexColor(GetTriggerUnit(), 255, 255, 255, 255)
    call SetUnitMoveSpeed(GetTriggerUnit(), 340.00)
    call UnitRemoveAbilityBJ('A06A', GetTriggerUnit())
endfunction

//===========================================================================
function InitTrig_kuanghua takes nothing returns nothing
    set gg_trg_kuanghua=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_kuanghua, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_kuanghua, Condition(function Trig_kuanghuaConditions))
    call TriggerAddAction(gg_trg_kuanghua, function Trig_kuanghuaActions)
endfunction

