    call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), ( 90.00 * I2R(GetUnitAbilityLevelSwapped('A0M2', GetAttacker())) ), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
