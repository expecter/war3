//===========================================================================
// Trigger: ufo
//===========================================================================
function Trig_ufoConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0DU' ) )
endfunction

function Trig_ufoActions takes nothing returns nothing
    set udg_UFO1[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetLoc()
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_094")
    call PingMinimapEx(GetLocationX(GetSpellTargetLoc()), GetLocationY(GetSpellTargetLoc()), 30.00, 255, 0, 0, false)
    call PlaySoundAtPointBJ(gg_snd_ALARM8, 100, udg_target[GetConvertedPlayerId(GetTriggerPlayer())], 0)
    call YDWEPolledWaitNull(10.00)
    call CreateNUnitsAtLoc(1, 'n01P', GetTriggerPlayer(), PolarProjectionBJ(udg_UFO1[GetConvertedPlayerId(GetTriggerPlayer())], 800.00, 0), bj_UNIT_FACING)
    set udg_UFO2[GetConvertedPlayerId(GetTriggerPlayer())]=GetLastCreatedUnit()
    call IssuePointOrderLoc(udg_UFO2[GetConvertedPlayerId(GetTriggerPlayer())], "move", udg_UFO1[GetConvertedPlayerId(GetTriggerPlayer())])
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(udg_UFO2[GetConvertedPlayerId(GetTriggerPlayer())], 100, 100.00, 100.00, ( 100.00 - ( 10.00 * I2R(GetForLoopIndexA()) ) ))
        call YDWEPolledWaitNull(0.10)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call IssueImmediateOrder(udg_UFO2[GetConvertedPlayerId(GetTriggerPlayer())], "locustswarm")
    call YDWEPolledWaitNull(1.00)
    call PauseUnitBJ(true, udg_UFO2[GetConvertedPlayerId(GetTriggerPlayer())])
    call YDWEPolledWaitNull(32.00)
    call PauseUnitBJ(false, udg_UFO2[GetConvertedPlayerId(GetTriggerPlayer())])
    call IssuePointOrderLoc(udg_UFO2[GetConvertedPlayerId(GetTriggerPlayer())], "move", PolarProjectionBJ(udg_UFO1[GetConvertedPlayerId(GetTriggerPlayer())], 1000.00, GetRandomDirectionDeg()))
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(udg_UFO2[GetConvertedPlayerId(GetTriggerPlayer())], 100, 100.00, 100.00, ( 0.00 + ( 10.00 * I2R(GetForLoopIndexA()) ) ))
        call YDWEPolledWaitNull(0.20)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call RemoveUnit(udg_UFO2[GetConvertedPlayerId(GetTriggerPlayer())])
endfunction

//===========================================================================
function InitTrig_ufo takes nothing returns nothing
    set gg_trg_ufo=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ufo, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_ufo, Condition(function Trig_ufoConditions))
    call TriggerAddAction(gg_trg_ufo, function Trig_ufoActions)
endfunction

//===========================================================================
// Trigger: xinlingzhihuo 2
//===========================================================================
function Trig_xinlingzhihuo_2Conditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A071' ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction

function Trig_xinlingzhihuo_2Func001Func001Func001001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == false ) )
endfunction

function Trig_xinlingzhihuo_2Func001Func001Func001A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'e00A', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('A071', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('A071', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A071', GetTriggerUnit()))
    call IssueTargetOrder(GetLastCreatedUnit(), "innerfire", GetEnumUnit())
    call ShowUnitHide(GetLastCreatedUnit())
endfunction

function Trig_xinlingzhihuo_2Func001Func002001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == false ) )
endfunction

function Trig_xinlingzhihuo_2Func001Func002A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'e00A', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('A071', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('A071', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A071', GetTriggerUnit()))
    call IssueTargetOrder(GetLastCreatedUnit(), "innerfire", GetEnumUnit())
    call ShowUnitHide(GetLastCreatedUnit())
endfunction

function Trig_xinlingzhihuo_2Actions takes nothing returns nothing
    if ( ( GetUnitAbilityLevelSwapped('A071', GetTriggerUnit()) == 2 ) ) then
        call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(300.00 , GetSpellTargetLoc() , Condition(function Trig_xinlingzhihuo_2Func001Func002001003)), function Trig_xinlingzhihuo_2Func001Func002A)
    else
        if ( ( GetUnitAbilityLevelSwapped('A071', GetTriggerUnit()) == 3 ) ) then
            call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(500.00 , GetSpellTargetLoc() , Condition(function Trig_xinlingzhihuo_2Func001Func001Func001001003)), function Trig_xinlingzhihuo_2Func001Func001Func001A)
        else
        endif
    endif
    call DestroyGroup(GetLastCreatedGroup())
endfunction

//===========================================================================
function InitTrig_xinlingzhihuo_2 takes nothing returns nothing
    set gg_trg_xinlingzhihuo_2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_xinlingzhihuo_2, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_xinlingzhihuo_2, Condition(function Trig_xinlingzhihuo_2Conditions))
    call TriggerAddAction(gg_trg_xinlingzhihuo_2, function Trig_xinlingzhihuo_2Actions)
endfunction

