//===========================================================================
// Trigger: Melee Initialization
//
// Default melee game initialization for all players
//===========================================================================
function Trig_Melee_InitializationActions takes nothing returns nothing
    set udg_shuangzhiaishang=0
    set udg_wupinchi[1]=CreateItemPool()
    set udg_momianwanjiazu=CreateForce()
    call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 60.00, "TRIGSTR_3688")
    call MeleeStartingVisibility()
    call MeleeStartingHeroLimit()
    call MeleeGrantHeroItems()
    call MeleeStartingUnitsForPlayer(GetPlayerRace(Player(8)), Player(8), GetPlayerStartLocationLoc(Player(8)), false)
    call MeleeStartingUnitsForPlayer(GetPlayerRace(Player(9)), Player(9), GetPlayerStartLocationLoc(Player(9)), false)
    call MeleeStartingUnitsForPlayer(GetPlayerRace(Player(10)), Player(10), GetPlayerStartLocationLoc(Player(10)), false)
    call MeleeStartingUnitsForPlayer(GetPlayerRace(Player(11)), Player(11), GetPlayerStartLocationLoc(Player(11)), false)
    call MeleeStartingResources()
    call SetGameDifficulty(MAP_DIFFICULTY_HARD)
    call MeleeStartingAI()
    call ShareEverythingWithTeam(Player(11))
    call MeleeInitVictoryDefeat()
    call CreateFogModifierRectBJ(true, Player(11), FOG_OF_WAR_VISIBLE, gg_rct______________000)
    call CreateFogModifierRectBJ(true, Player(11), FOG_OF_WAR_VISIBLE, gg_rct______________013)
    call CreateFogModifierRectBJ(true, Player(11), FOG_OF_WAR_VISIBLE, gg_rct______________014)
    call CreateFogModifierRectBJ(true, Player(11), FOG_OF_WAR_VISIBLE, gg_rct______________015)
