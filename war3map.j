function Trig_kuanghua3Func004001 takes nothing returns boolean
    return ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B03Z') == false ) )
endfunction

function Trig_kuanghua3Actions takes nothing returns nothing
    call UnitAddAbilityBJ('A0PU', GetTriggerUnit())
    call SetUnitVertexColorBJ(GetTriggerUnit(), 100, 0.00, 0.00, 0.00)
    call YDWEPolledWaitNull(1.00)
    loop
        exitwhen ( (UnitHasBuffBJ(GetTriggerUnit(), 'B03Z') == false) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    call UnitRemoveAbilityBJ('A0PU', GetTriggerUnit())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(GetTriggerUnit(), 100, ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), 0.00)
        call YDWEPolledWaitNull(0.20)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitVertexColorBJ(GetTriggerUnit(), 100, 100.00, 100.00, 0.00)
endfunction

