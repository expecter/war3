//===========================================================================
// Trigger: binglitu
//===========================================================================
function Trig_binglituConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0L8' ) )
endfunction

function Trig_binglituFunc006001 takes nothing returns boolean
    return ( ( UnitHasBuffBJ(udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())], 'B02E') == true ) )
endfunction

function Trig_binglituFunc007A takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ("origin", GetEnumUnit(), "Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call CreateNUnitsAtLoc(1, 'h00V', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())]), bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(3.00, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('A09W', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('A09W', GetLastCreatedUnit(), 5)
    call IssueTargetOrder(GetLastCreatedUnit(), "frostnova", GetEnumUnit())
endfunction

function Trig_binglituActions takes nothing returns nothing
    set udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetUnit()
    call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I092'))
    call UnitAddItemByIdSwapped('I091', GetTriggerUnit())
    call AddSpecialEffectTargetUnitBJ("hand right", GetTriggerUnit(), "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    loop
        exitwhen ( (UnitHasBuffBJ(udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())], 'B02E') == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    call ForGroupBJ((YDWEGetUnitsInRangeOfLocMatchingNull(((600.00 )*1.0) , ( GetUnitLoc(udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())])) , null)), function Trig_binglituFunc007A) // INLINED!!
endfunction

