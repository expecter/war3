// Trigger: shenqiyaoshui
//===========================================================================
function Trig_shenqiyaoshuiConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0D0' ) )
endfunction

function Trig_shenqiyaoshuiActions takes nothing returns nothing
    call AddSpecialEffectLocBJ(GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Orc\\Disenchant\\DisenchantSpecialArt.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call SetUnitVertexColor(GetTriggerUnit(), 0, 255, 255, 255)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(GetTriggerUnit(), ( 10.00 + ( 7.00 * I2R(bj_forLoopAIndex) ) ), 100.00, 100.00, 0.00)
        call YDWEPolledWaitNull(6.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitVertexColor(GetTriggerUnit(), 255, 255, 255, 255)
endfunction

