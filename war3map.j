endfunction

function Trig_bianshen_xiaoqiangActions takes nothing returns nothing
    call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'U002' , bj_UNIT_STATE_METHOD_RELATIVE)
    call AddSpecialEffectLocBJ(GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Human\\ReviveHuman\\ReviveHuman.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 20.00, ( "魔神复活了……" ))
    call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 15.00, "TRIGSTR_7990")
    call RemoveItem(GetManipulatedItem())
    if ( ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) != MAP_CONTROL_USER ) ) then
        call SelectHeroSkill(GetLastReplacedUnitBJ(), 'A0AK')
        call SelectHeroSkill(GetLastReplacedUnitBJ(), 'A0AG')
        call SelectHeroSkill(GetLastReplacedUnitBJ(), 'AUim')
        call SelectHeroSkill(GetLastReplacedUnitBJ(), 'AUim')
