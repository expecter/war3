    return ( ( IsUnitInGroup(GetTriggerUnit(), (YDWEGetUnitsOfPlayerMatchingNull((Player(PLAYER_NEUTRAL_AGGRESSIVE)) , null))) == true ) and ( IsUnitIllusionBJ(GetTriggerUnit()) == false ) ) // INLINED!!
