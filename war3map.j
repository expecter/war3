//===========================================================================
// Trigger: xueyinqiubeigongji
//===========================================================================
function Trig_xueyinqiubeigongjiConditions takes nothing returns boolean
    return ( ( IsUnitIllusionBJ(GetAttacker()) == false ) )
endfunction

function Trig_xueyinqiubeigongjiActions takes nothing returns nothing
    if ( ( UnitHasItemOfTypeBJ(GetAttacker(), 'I08I') == true ) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I087') == true ) ) then
        call CreateUnitAtLoc(GetOwningPlayer(GetAttacker()), 'e00L', GetUnitLoc(GetAttacker()), 0)
        call UnitApplyTimedLife(GetLastCreatedUnit(), 'BHwe', 2.00)
        call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathMissile.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
    else
        if ( ( UnitHasItemOfTypeBJ(GetAttacker(), 'I08H') == true ) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I07T') == true ) ) then
            call CreateUnitAtLoc(GetOwningPlayer(GetAttacker()), 'e00L', GetUnitLoc(GetAttacker()), 0)
            call UnitApplyTimedLife(GetLastCreatedUnit(), 'BHwe', 2.00)
            call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathMissile.mdl")
            call DestroyEffect(GetLastCreatedEffectBJ())
        else
        endif
    endif
endfunction

