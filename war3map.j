//===========================================================================
// Trigger: shizigonggj
//===========================================================================
function Trig_shizigonggjConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0LB' ) )
endfunction

function Trig_shizigonggjFunc002001 takes nothing returns boolean
    return ( ( ( UnitHasBuffBJ(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], 'B02T') == true ) or ( UnitHasBuffBJ(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], 'B02U') == true ) ) )
endfunction

function Trig_shizigonggjFunc004Func007001003 takes nothing returns boolean
    return ( ( ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true ) and ( ( IsUnitAliveBJ(GetFilterUnit()) == true ) and ( GetFilterUnit() != udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())] ) ) ) )
endfunction

function Trig_shizigonggjFunc004Func007A takes nothing returns nothing
    call UnitDamageTarget(GetTriggerUnit(), GetEnumUnit(), 600.00, true, true, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_SONIC, WEAPON_TYPE_METAL_HEAVY_CHOP)
    call AddSpecialEffectTargetUnitBJ("origin", GetEnumUnit(), "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

function Trig_shizigonggjFunc005Func009001003 takes nothing returns boolean
    return ( ( ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true ) and ( ( IsUnitAliveBJ(GetFilterUnit()) == true ) and ( GetFilterUnit() != udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())] ) ) ) )
endfunction

function Trig_shizigonggjFunc005Func009A takes nothing returns nothing
    call UnitDamageTarget(GetTriggerUnit(), GetEnumUnit(), 600.00, true, true, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_SONIC, WEAPON_TYPE_METAL_HEAVY_CHOP)
    call AddSpecialEffectTargetUnitBJ("origin", GetEnumUnit(), "Abilities\\Weapons\\Bolt\\BoltImpact.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call AddSpecialEffectTargetUnitBJ("origin", GetEnumUnit(), "Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCaster.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

function Trig_shizigonggjActions takes nothing returns nothing
    set udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetUnit()
    loop
        exitwhen ( (( UnitHasBuffBJ(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], 'B02T') == true ) or ( UnitHasBuffBJ(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], 'B02U') == true )) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    if ( ( ( UnitItemInSlotBJ(GetTriggerUnit(), 2) != GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I096') ) or ( UnitItemInSlotBJ(GetTriggerUnit(), 2) != GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I09B') ) or ( UnitItemInSlotBJ(GetTriggerUnit(), 2) != GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I097') ) or ( UnitItemInSlotBJ(GetTriggerUnit(), 2) != GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I098') ) ) ) then
        call AddSpecialEffectTargetUnitBJ("origin", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Other\\Stampede\\MissileDeath.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call UnitDamageTarget(GetTriggerUnit(), udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], 300.00, true, false, ATTACK_TYPE_PIERCE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    else
    endif
    if ( ( UnitItemInSlotBJ(GetTriggerUnit(), 2) == GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I09B') ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I09B') == true ) ) then
        call RemoveItem(UnitItemInSlotBJ(GetTriggerUnit(), 2))
        call UnitDamageTarget(GetTriggerUnit(), udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], 900.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        call AddSpecialEffectTargetUnitBJ("chest", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(400.00 , GetUnitLoc(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())]) , Condition(function Trig_shizigonggjFunc004Func007001003)), function Trig_shizigonggjFunc004Func007A)
    else
    endif
    if ( ( UnitItemInSlotBJ(GetTriggerUnit(), 2) == GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I095') ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I095') == true ) ) then
        call RemoveItem(UnitItemInSlotBJ(GetTriggerUnit(), 2))
        call UnitDamageTarget(GetTriggerUnit(), udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], 500.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        call AddSpecialEffectTargetUnitBJ("chest", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Weapons\\Bolt\\BoltImpact.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call AddSpecialEffectTargetUnitBJ("overhead", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCaster.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(400.00 , GetUnitLoc(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())]) , Condition(function Trig_shizigonggjFunc005Func009001003)), function Trig_shizigonggjFunc005Func009A)
    else
    endif
    if ( ( UnitItemInSlotBJ(GetTriggerUnit(), 2) == GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I097') ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I097') == true ) ) then
        call RemoveItem(UnitItemInSlotBJ(GetTriggerUnit(), 2))
        call AddSpecialEffectTargetUnitBJ("chest", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Objects\\Spawnmodels\\Naga\\NagaBlood\\NagaBloodWindserpent.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        set bj_forLoopAIndex=0
        set bj_forLoopAIndexEnd=5
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call UnitDamageTarget(GetTriggerUnit(), udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], 100.00, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            call AddSpecialEffectTargetUnitBJ("chest", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Weapons\\ChimaeraAcidMissile\\ChimaeraAcidMissile.mdl")
            call DestroyEffect(GetLastCreatedEffectBJ())
            call YDWEPolledWaitNull(0.03)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call DestroyEffect(GetLastCreatedEffectBJ())
    else
    endif
    if ( ( UnitItemInSlotBJ(GetTriggerUnit(), 2) == GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I098') ) ) then
        call UnitDamageTarget(GetTriggerUnit(), udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], 300.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        call AddSpecialEffectTargetUnitBJ("chest", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Other\\Stampede\\MissileDeath.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call AddSpecialEffectTargetUnitBJ("chest", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Items\\OrbDarkness\\OrbDarkness.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
    else
    endif
endfunction

