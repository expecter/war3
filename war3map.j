                call SetUnitManaBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - 100.00 ))
            else
            endif
        else
            if ( ( GetUnitAbilityLevelSwapped('AUim', GetTriggerUnit()) == 3 ) ) then
                if ( ( GetRandomInt(1, 8) == 2 ) ) then
                    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(500.00 , GetUnitLoc(GetTriggerUnit()) , Condition(function Trig_chunciFunc001Func001Func001Func003Func001001003)), function Trig_chunciFunc001Func001Func001Func003Func001A)
                    call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl")
                    call DestroyEffect(GetLastCreatedEffectBJ())
                    call SetUnitManaBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - 100.00 ))
                else
                endif
            else
                if ( ( GetUnitAbilityLevelSwapped('AUim', GetTriggerUnit()) == 4 ) ) then
                    if ( ( GetRandomInt(1, 7) == 2 ) ) then
                        call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(500.00 , GetUnitLoc(GetSpellTargetUnit()) , Condition(function Trig_chunciFunc001Func001Func001Func001Func003Func001001003)), function Trig_chunciFunc001Func001Func001Func001Func003Func001A)
                        call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl")
                        call DestroyEffect(GetLastCreatedEffectBJ())
                        call SetUnitManaBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - 100.00 ))
                    else
                    endif
                else
                    if ( ( GetUnitAbilityLevelSwapped('AUim', GetTriggerUnit()) == 5 ) ) then
                        if ( ( GetRandomInt(1, 6) == 2 ) ) then
                            call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(500.00 , GetUnitLoc(GetSpellTargetUnit()) , Condition(function Trig_chunciFunc001Func001Func001Func001Func001Func002Func001001003)), function Trig_chunciFunc001Func001Func001Func001Func001Func002Func001A)
                            call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl")
                            call DestroyEffect(GetLastCreatedEffectBJ())
                            call SetUnitManaBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - 100.00 ))
                        else
