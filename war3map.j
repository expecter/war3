//===========================================================================
// Trigger: shayingxiong
//===========================================================================
function Trig_shayingxiongConditions takes nothing returns boolean
    return ( ( IsUnitEnemy(GetTriggerUnit(), Player(11)) == true ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction

function Trig_shayingxiongActions takes nothing returns nothing
    call AdjustPlayerStateBJ(( GetUnitLevel(GetTriggerUnit()) * udg_qianyinsu ), GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD)
    call AddHeroXPSwapped(( udg_jingyanzhifujia * GetUnitLevel(GetTriggerUnit()) ), GetKillingUnitBJ(), true)
    call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetOwningPlayer(GetKillingUnitBJ())), 10.00, ( "|cffffcc00杀死敌方英雄，经验值附加" + I2S(( GetUnitLevel(GetTriggerUnit()) * udg_jingyanzhifujia )) ))
    call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetOwningPlayer(GetKillingUnitBJ())), 10.00, ( "|cffffcc00杀死敌方英雄现金增加" + I2S(( GetUnitLevel(GetTriggerUnit()) * udg_qianyinsu )) ))
    call YDWEPolledWaitNull(125.00)
    if ( ( IsUnitAliveBJ(GetTriggerUnit()) == true ) and ( GetUnitLevel(GetTriggerUnit()) < 15 ) ) then
        call AddHeroXPSwapped(( udg_qianyinsu + 50 ), GetTriggerUnit(), true)
    else
    endif
endfunction

