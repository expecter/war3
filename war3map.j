//===========================================================================
// Trigger: juji
//===========================================================================
function Trig_jujiConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0CM' ) )
endfunction

function Trig_jujiFunc002001 takes nothing returns boolean
    return ( ( UnitHasBuffBJ(GetSpellTargetUnit(), 'B01X') == true ) )
endfunction

function Trig_jujiActions takes nothing returns nothing
    call SetUnitAnimation(GetTriggerUnit(), "spell")
    loop
        exitwhen ( (UnitHasBuffBJ(GetSpellTargetUnit(), 'B01X') == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    if ( ( GetRandomInt(1, 20) == 10 ) ) then
        call AddSpecialEffectTargetUnitBJ("overhead", GetSpellTargetUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
        call AddSpecialEffectTargetUnitBJ("overhead", GetSpellTargetUnit(), "Objects\\Spawnmodels\\Orc\\OrcLargeDeathExplode\\OrcLargeDeathExplode.mdl")
        call UnitDamageTarget(GetTriggerUnit(), GetSpellTargetUnit(), 5000.00, true, true, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_DEMOLITION, WEAPON_TYPE_WHOKNOWS)
    else
        call AddSpecialEffectTargetUnitBJ("overhead", GetSpellTargetUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
        call UnitDamageTarget(GetTriggerUnit(), GetSpellTargetUnit(), GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()), true, true, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_DEMOLITION, WEAPON_TYPE_WHOKNOWS)
    endif
    call SetUnitManaPercentBJ(GetTriggerUnit(), 0.00)
endfunction

//===========================================================================
function InitTrig_juji takes nothing returns nothing
    set gg_trg_juji=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_juji, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_juji, Condition(function Trig_jujiConditions))
    call TriggerAddAction(gg_trg_juji, function Trig_jujiActions)
endfunction

