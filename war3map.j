//===========================================================================
// Trigger: shengguangzuzhou
//===========================================================================
function Trig_shengguangzuzhouConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A081' ) )
endfunction

function Trig_shengguangzuzhouActions takes nothing returns nothing
    if ( ( GetUnitAbilityLevelSwapped('A081', GetTriggerUnit()) == 1 ) and ( IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_UNDEAD) == false ) ) then
        call SetUnitManaBJ(GetSpellTargetUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetSpellTargetUnit()) + 100.00 ))
    else
        if ( ( GetUnitAbilityLevelSwapped('A081', GetTriggerUnit()) == 2 ) and ( IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_UNDEAD) == false ) ) then
            call SetUnitManaBJ(GetSpellTargetUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetSpellTargetUnit()) + 200.00 ))
        else
            if ( ( GetUnitAbilityLevelSwapped('A081', GetTriggerUnit()) == 3 ) and ( IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_UNDEAD) == false ) ) then
                call SetUnitManaBJ(GetSpellTargetUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetSpellTargetUnit()) + 300.00 ))
            else
                if ( ( GetUnitAbilityLevelSwapped('A081', GetTriggerUnit()) == 4 ) and ( IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_UNDEAD) == false ) ) then
                    call SetUnitManaBJ(GetSpellTargetUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetSpellTargetUnit()) + 400.00 ))
                else
                endif
            endif
        endif
    endif
endfunction

