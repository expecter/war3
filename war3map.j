function Trig_fumianyingxiangActions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ("weapon", GetKillingUnitBJ(), "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    if ( ( GetUnitAbilityLevelSwapped('A0HY', gg_unit_H001_0524) < 20 ) and ( udg_shuangzhiaishang == 2 ) ) then
        call IncUnitAbilityLevelSwapped('A0HY', gg_unit_H001_0524)
        call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetOwningPlayer(GetKillingUnitBJ())), 10.00, "TRIGSTR_5817")
        set udg_shuangzhiaishang=0
    else
        set udg_shuangzhiaishang=( udg_shuangzhiaishang + 1 )
    endif
    call AddSpecialEffectTargetUnitBJ("weapon", GetKillingUnitBJ(), "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

