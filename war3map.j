    set gg_trg_liuxingchui=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_liuxingchui, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_liuxingchui, Condition(function Trig_liuxingchuiConditions))
