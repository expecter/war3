function Trig_houwu_gConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0CS' ) )
endfunction

function Trig_houwu_gActions takes nothing returns nothing
    call RemoveWeatherEffect(GetLastCreatedWeatherEffect())
    call DisableTrigger(gg_trg_quntishengguang_sun)
    call DisableTrigger(gg_trg_quntibingshuang_snow)
    call DisableTrigger(gg_trg_baofengxuejiaqiang)
    call DisableTrigger(gg_trg_tianqi_shuiyueren)
    call DisableTrigger(gg_trg_baofengxuejiaqiang_2)
    call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7094")
endfunction

//===========================================================================
function InitTrig_houwu_g takes nothing returns nothing
    set gg_trg_houwu_g=CreateTrigger()
    call DisableTrigger(gg_trg_houwu_g)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_houwu_g, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_houwu_g, Condition(function Trig_houwu_gConditions))
    call TriggerAddAction(gg_trg_houwu_g, function Trig_houwu_gActions)
endfunction

