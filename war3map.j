        call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetOwningPlayer(GetKillingUnitBJ())), 10.00, "TRIGSTR_6515")
    else
        call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetOwningPlayer(GetKillingUnitBJ())), 10.00, "TRIGSTR_6516")
