//===========================================================================
function Trig_taotiezhiyanConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0QA' ) )
endfunction

function Trig_taotiezhiyanActions takes nothing returns nothing
    set udg_eshishi2=R2I(GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()))
    if ( ( I2R(udg_eshishi2) >= 1000.00 ) ) then
        call UnitAddAbilityBJ('A0Q9', GetTriggerUnit())
        call SetUnitVertexColorBJ(GetTriggerUnit(), 0.00, 100.00, 0.00, 0.00)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=60
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetUnitLifeBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( I2R(udg_eshishi2) / 20.00 ) ))
            call YDWEPolledWaitNull(1.00)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=10
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetUnitVertexColorBJ(GetTriggerUnit(), ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), 100.00, ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), 0.00)
            call YDWEPolledWaitNull(0.20)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call SetUnitVertexColorBJ(GetTriggerUnit(), 100, 100.00, 100.00, 0.00)
        call UnitRemoveAbilityBJ('A0Q9', GetTriggerUnit())
    else
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=40
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetUnitLifeBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( I2R(udg_eshishi2) / 20.00 ) ))
            call YDWEPolledWaitNull(1.00)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    endif
endfunction

