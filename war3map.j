//===========================================================================
function Trig_fanjiConditions takes nothing returns boolean
    return ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) and ( GetPlayerController(GetTriggerPlayer()) != MAP_CONTROL_USER ) and ( GetOwningPlayer(GetTriggerUnit()) != Player(11) ) and ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) and ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) ) and ( IsUnitType(GetAttacker(), UNIT_TYPE_HERO) == true ) and ( GetOwningPlayer(GetAttacker()) != Player(11) ) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I074') == false ) )
endfunction

function Trig_fanjiFunc002001003 takes nothing returns boolean
    return ( ( ( IsUnitAlly(GetFilterUnit(), GetTriggerPlayer()) == true ) and ( GetFilterUnit() != GetTriggerUnit() ) ) )
endfunction

function Trig_fanjiFunc002A takes nothing returns nothing
    call IssueTargetOrder(GetEnumUnit(), "attack", GetAttacker())
endfunction

function Trig_fanjiActions takes nothing returns nothing
    if ( ( GetUnitLifePercent(GetTriggerUnit()) >= 0.30 ) ) then
        call IssueTargetOrder(GetTriggerUnit(), "attack", GetAttacker())
    else
    endif
    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(400.00 , GetUnitLoc(GetTriggerUnit()) , Condition(function Trig_fanjiFunc002001003)), function Trig_fanjiFunc002A)
endfunction

