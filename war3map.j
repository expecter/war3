function Trig_zhanshaConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0KU' ) )
endfunction

function Trig_zhanshaActions takes nothing returns nothing
    set udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetUnit()
    set udg_yizhantexiao=AddSpecialEffectTarget("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl", GetTriggerUnit(), "weapon")
    set udg_yishanweizhi=GetUnitLoc(GetSpellTargetUnit())
    call YDWEPolledWaitNull(0.40)
    call SetUnitPositionLoc(GetTriggerUnit(), PolarProjectionBJ(udg_yishanweizhi, ( DistanceBetweenPoints(udg_yishanweizhi, GetUnitLoc(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())])) - 75.00 ), AngleBetweenPoints(udg_yishanweizhi, GetUnitLoc(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())]))))
    call UnitDamageTarget(GetTriggerUnit(), udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true)) + ( I2R(GetUnitAbilityLevelSwapped('A0KU', GetTriggerUnit())) * 100.00 ) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("chest", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call YDWEPolledWaitNull(0.05)
    call AddSpecialEffectTargetUnitBJ("chest", udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call YDWEPolledWaitNull(0.40)
    call DestroyEffect(udg_yizhantexiao)
    call RemoveLocation(udg_yishanweizhi)
endfunction

