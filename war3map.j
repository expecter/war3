//===========================================================================
// Trigger: yizhan
//===========================================================================
function Trig_yizhanConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A08A' ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I018') == false ) )
endfunction

function Trig_yizhanActions takes nothing returns nothing
    set udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetUnit()
    set udg_yizhantexiao=AddSpecialEffectTarget("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl", GetTriggerUnit(), "weapon")
    set udg_yishanweizhi=GetUnitLoc(GetSpellTargetUnit())
    call SetUnitAnimation(GetTriggerUnit(), "attack slam")
    call YDWEPolledWaitNull(0.40)
    call SetUnitPositionLoc(GetTriggerUnit(), PolarProjectionBJ(udg_yishanweizhi, ( DistanceBetweenPoints(udg_yishanweizhi, GetUnitLoc(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())])) + 10.00 ), AngleBetweenPoints(udg_yishanweizhi, GetUnitLoc(udg_xzhan1[GetConvertedPlayerId(GetTriggerPlayer())]))))
    call YDWEPolledWaitNull(0.40)
    call DestroyEffect(udg_yizhantexiao)
    call RemoveLocation(udg_yishanweizhi)
endfunction

//===========================================================================
function InitTrig_yizhan takes nothing returns nothing
    set gg_trg_yizhan=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_yizhan, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_yizhan, Condition(function Trig_yizhanConditions))
    call TriggerAddAction(gg_trg_yizhan, function Trig_yizhanActions)
endfunction

