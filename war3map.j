//===========================================================================
// Trigger: liulianzhan2
//===========================================================================
function Trig_liulianzhan2Conditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A05E' ) )
endfunction

function Trig_liulianzhan2Actions takes nothing returns nothing
    call ShowUnitHide(GetTriggerUnit())
    set udg_liulianzhan5=GetSpellTargetUnit()
    set udg_liulianzhan6=GetTriggerUnit()
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'n00V', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(udg_liulianzhan5), 400.00, ( I2R(GetForLoopIndexA()) * 60.00 )), GetUnitLoc(udg_liulianzhan5))
        call AddSpecialEffectLocBJ(GetUnitLoc(GetLastCreatedUnit()), "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl")
        call IssueTargetOrder(GetLastCreatedUnit(), "thunderbolt", udg_liulianzhan5)
        set udg_liulianzhan3[( bj_forLoopAIndex + 6 )]=GetLastCreatedEffectBJ()
        set udg_liulianzhan2[bj_forLoopAIndex]=GetLastCreatedUnit()
        set udg_liulianzhan=GetUnitLoc(udg_liulianzhan5)
        call YDWEPolledWaitNull(0.10)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call YDWEPolledWaitNull(0.90)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call AddSpecialEffectLocBJ(GetUnitLoc(udg_liulianzhan2[bj_forLoopAIndex]), "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl")
        call RemoveUnit(udg_liulianzhan2[bj_forLoopAIndex])
        set udg_liulianzhan3[bj_forLoopAIndex]=GetLastCreatedEffectBJ()
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call YDWEPolledWaitNull(0.50)
    call ShowUnitShow(GetTriggerUnit())
    call SetUnitPositionLoc(GetTriggerUnit(), udg_liulianzhan)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call DestroyEffect(udg_liulianzhan3[bj_forLoopAIndex])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call UnitDamageTarget(GetTriggerUnit(), udg_liulianzhan4, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_liulianzhan6) / 3.00 ), true, true, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_SONIC, WEAPON_TYPE_METAL_HEAVY_CHOP)
        call AddSpecialEffectTargetUnitBJ("chest", udg_liulianzhan5, "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
        call YDWEPolledWaitNull(0.10)
        call DestroyEffect(GetLastCreatedEffectBJ())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitManaPercentBJ(udg_liulianzhan6, 0.00)
endfunction

//===========================================================================
function InitTrig_liulianzhan2 takes nothing returns nothing
    set gg_trg_liulianzhan2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_liulianzhan2, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_liulianzhan2, Condition(function Trig_liulianzhan2Conditions))
    call TriggerAddAction(gg_trg_liulianzhan2, function Trig_liulianzhan2Actions)
endfunction

