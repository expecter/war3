function config takes nothing returns nothing
    call SetMapName("TRIGSTR_014")
    call SetMapDescription("TRIGSTR_016")
    call SetPlayers(10)
    call SetTeams(10)
    call SetGamePlacement(MAP_PLACEMENT_TEAMS_TOGETHER)

    call DefineStartLocation(0, 6848.0, 16576.0)
    call DefineStartLocation(1, 6784.0, 16576.0)
    call DefineStartLocation(2, 6784.0, 16576.0)
    call DefineStartLocation(3, 6784.0, 16576.0)
    call DefineStartLocation(4, 6784.0, 16576.0)
    call DefineStartLocation(5, 6784.0, 16576.0)
    call DefineStartLocation(6, - 1216.0, - 8256.0)
    call DefineStartLocation(7, 704.0, - 10240.0)
    call DefineStartLocation(8, 2624.0, - 8256.0)
    call DefineStartLocation(9, - 896.0, 9664.0)

    // Player setup
    call InitCustomPlayerSlots()
    call InitCustomTeams()
    call InitAllyPriorities()
endfunction




























































