//===========================================================================
// Trigger: zhanlongjue1
//===========================================================================
function Trig_zhanlongjue1Conditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A032' ) )
endfunction

function Trig_zhanlongjue1Actions takes nothing returns nothing
    set udg_zhanlongjuehero[GetConvertedPlayerId(GetTriggerPlayer())]=GetTriggerUnit()
    call SetUnitVertexColor(GetTriggerUnit(), 100, 0, 0, 255)
    call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\Orc\\Shockwave\\ShockwaveMissile.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    if ( ( GetUnitLevel(udg_zhanlongjuehero[GetConvertedPlayerId(GetTriggerPlayer())]) < 10 ) ) then
        set udg_zhanlongjue3=0.90
    else
        if ( ( GetUnitLevel(udg_zhanlongjuehero[GetConvertedPlayerId(GetTriggerPlayer())]) >= 10 ) ) then
            set udg_zhanlongjue3=( I2R(GetUnitLevel(GetTriggerUnit())) / 10.00 )
        else
        endif
    endif
    set udg_S=( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) * udg_zhanlongjue3 )
    call SetUnitManaPercentBJ(GetTriggerUnit(), 0.00)
    call CreateNUnitsAtLoc(1, 'e00G', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), GetUnitFacing(GetTriggerUnit()))
    set udg_Z[1]=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(1.50, 'BTLF', udg_Z[1])
    call CreateNUnitsAtLoc(1, 'e00G', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), GetUnitFacing(GetTriggerUnit()))
    set udg_Z[2]=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(1.50, 'BTLF', udg_Z[2])
    call CreateNUnitsAtLoc(1, 'e00G', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), GetUnitFacing(GetTriggerUnit()))
    set udg_Z[3]=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(1.50, 'BTLF', udg_Z[3])
    set udg_U=CreateGroup()
    call EnableTrigger(gg_trg_zhanlongjue2)
    call YDWEPolledWaitNull(1.50)
    call DisableTrigger(gg_trg_zhanlongjue2)
    set udg_Z[1]=null
    set udg_Z[2]=null
    set udg_Z[3]=null
    call GroupClear(udg_U)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(GetTriggerUnit(), 100, ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), ( 10.00 + ( 6.00 * I2R(GetForLoopIndexA()) ) ), 0.00)
        call YDWEPolledWaitNull(0.30)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitVertexColor(GetTriggerUnit(), 255, 255, 255, 255)
endfunction

//===========================================================================
function InitTrig_zhanlongjue1 takes nothing returns nothing
    set gg_trg_zhanlongjue1=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_zhanlongjue1, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_zhanlongjue1, Condition(function Trig_zhanlongjue1Conditions))
    call TriggerAddAction(gg_trg_zhanlongjue1, function Trig_zhanlongjue1Actions)
endfunction

