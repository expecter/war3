//===========================================================================
// Trigger: tianqi g
//===========================================================================
function Trig_tianqi_gActions takes nothing returns nothing
    call RemoveWeatherEffect(GetLastCreatedWeatherEffect())
    call DisableTrigger(gg_trg_quntishengguang_sun)
    call DisableTrigger(gg_trg_quntibingshuang_snow)
    call DisableTrigger(gg_trg_baofengxuejiaqiang)
    call DisableTrigger(gg_trg_tianqi_shuiyueren)
    call DisableTrigger(gg_trg_baofengxuejiaqiang_2)
    call EnableTrigger(gg_trg_huojian)
    call EnableTrigger(gg_trg_huojian_yongzhehuizhang)
    if ( ( GetRandomInt(1, 5) == 2 ) ) then
        call DisableTrigger(gg_trg_huojian)
        call DisableTrigger(gg_trg_huojian_yongzhehuizhang)
        call EnableTrigger(gg_trg_tianqi_shuiyueren)
        call EnableTrigger(gg_trg_baofengxuejiaqiang_2)
        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7084")
        call YDWEPolledWaitNull(3.00)
        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7085")
        call YDWEPolledWaitNull(3.00)
        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7086")
        call YDWEPolledWaitNull(3.00)
        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7087")
    else
        if ( ( GetRandomInt(1, 3) == 2 ) ) then
            call EnableTrigger(gg_trg_tianqi_shuiyueren)
            call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7067")
            call YDWEPolledWaitNull(3.00)
            call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7068")
        else
            if ( ( GetRandomInt(1, 3) == 2 ) ) then
                call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7083")
            else
                if ( ( GetRandomInt(1, 4) == 2 ) ) then
                    call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7082")
                else
                    if ( ( GetRandomInt(1, 4) == 2 ) ) then
                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7078")
                        call EnableTrigger(gg_trg_quntibingshuang_snow)
                        call EnableTrigger(gg_trg_baofengxuejiaqiang)
                        call EnableTrigger(gg_trg_tianqi_shuiyueren)
                        call YDWEPolledWaitNull(3.00)
                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7079")
                        call YDWEPolledWaitNull(3.00)
                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7080")
                        call YDWEPolledWaitNull(3.00)
                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7081")
                    else
                        if ( ( GetRandomInt(1, 4) == 2 ) ) then
                            call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7075")
                            call EnableTrigger(gg_trg_quntibingshuang_snow)
                            call EnableTrigger(gg_trg_tianqi_shuiyueren)
                            call YDWEPolledWaitNull(3.00)
                            call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7076")
                            call YDWEPolledWaitNull(3.00)
                            call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7077")
                        else
                            if ( ( GetRandomInt(1, 3) == 2 ) ) then
                                call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7073")
                                call EnableTrigger(gg_trg_quntishengguang_sun)
                                call YDWEPolledWaitNull(3.00)
                                call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7074")
                            else
                                if ( ( GetRandomInt(1, 3) == 2 ) ) then
                                    call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7072")
                                    call CreateNUnitsAtLoc(1, 'n012', Player(PLAYER_NEUTRAL_AGGRESSIVE), Location(0, 0), bj_UNIT_FACING)
                                    call UnitAddAbilityBJ('A09F', GetLastCreatedUnit())
                                    call IssueImmediateOrderById(GetLastCreatedUnit(), 852621)
                                    call RemoveUnit(GetLastCreatedUnit())
                                else
                                    if ( ( GetRandomInt(1, 3) == 2 ) ) then
                                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7070")
                                        call YDWEPolledWaitNull(3.00)
                                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7071")
                                        call CreateNUnitsAtLoc(1, 'n01H', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(GetPlayableMapRect()), bj_UNIT_FACING)
                                        call CreateNUnitsAtLoc(1, 'n01H', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(GetPlayableMapRect()), bj_UNIT_FACING)
                                        call CreateNUnitsAtLoc(1, 'n01H', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(GetPlayableMapRect()), bj_UNIT_FACING)
                                        call CreateNUnitsAtLoc(1, 'n01H', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(GetPlayableMapRect()), bj_UNIT_FACING)
                                    else
                                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_7069")
                                    endif
                                endif
                            endif
                        endif
                    endif
                endif
            endif
        endif
    endif
endfunction

