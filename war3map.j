    set gg_trg_binglitu=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_binglitu, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_binglitu, Condition(function Trig_binglituConditions))
    call TriggerAddAction(gg_trg_binglitu, function Trig_binglituActions)
endfunction

