    return ( ( UnitHasBuffBJ(udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())], 'B02E') == true ) )
endfunction

function Trig_huoqiushuFunc005001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) )
endfunction

function Trig_huoqiushuFunc005A takes nothing returns nothing
    call UnitDamageTarget(GetTriggerUnit(), GetEnumUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetTriggerUnit(), true)) * ( I2R(GetUnitAbilityLevelSwapped('A0IN', GetTriggerUnit())) + 1.00 ) ), true, true, ATTACK_TYPE_HERO, DAMAGE_TYPE_FIRE, WEAPON_TYPE_WHOKNOWS)
endfunction

function Trig_huoqiushuActions takes nothing returns nothing
    set udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetUnit()
    call AddSpecialEffectTargetUnitBJ("hand right", GetTriggerUnit(), "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    loop
        exitwhen ( (UnitHasBuffBJ(udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())], 'B02E') == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(250.00 , GetUnitLoc(udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())]) , Condition(function Trig_huoqiushuFunc005001003)), function Trig_huoqiushuFunc005A)
    call AddSpecialEffectTargetUnitBJ("origin", udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call AddSpecialEffectTargetUnitBJ("overhead", udg_shizizhuihunfu[GetConvertedPlayerId(GetTriggerPlayer())], "Units\\NightElf\\Wisp\\WispExplode.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

