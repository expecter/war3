//===========================================================================
// Trigger: mizhigonggongji
//===========================================================================
function Trig_mizhigonggongjiConditions takes nothing returns boolean
    return ( ( UnitHasItemOfTypeBJ(GetAttacker(), 'I03A') == true ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(GetTriggerUnit()))) >= 300 ) and ( IsUnitIllusionBJ(GetAttacker()) == false ) )
endfunction

function Trig_mizhigonggongjiActions takes nothing returns nothing
    call YDWEPolledWaitNull(0.50)
    if ( ( IsUnitAliveBJ(GetTriggerUnit()) == true ) and ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetAttacker(), 'I03A')) != 0 ) ) then
        set bj_forLoopAIndex=0
        set bj_forLoopAIndexEnd=GetItemCharges(GetItemOfTypeFromUnitBJ(GetAttacker(), 'I03A'))
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), 75.00, true, true, ATTACK_TYPE_PIERCE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
            call DestroyEffect(GetLastCreatedEffectBJ())
            call YDWEPolledWaitNull(0.01)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    else
    endif
endfunction

