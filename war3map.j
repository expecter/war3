    call CreateNUnitsAtLoc(1, 'e00A', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('AHtb', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('AHtb', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('AHtb', GetTriggerUnit()))
    call IssueTargetOrder(GetLastCreatedUnit(), "thunderbolt", GetEnumUnit())
    call ShowUnitHide(GetLastCreatedUnit())
endfunction

function Trig_liuxingchuiFunc001Func003Func001001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) )
endfunction

function Trig_liuxingchuiFunc001Func003Func001A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'e00A', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('AHtb', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('AHtb', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('AHtb', GetTriggerUnit()))
    call IssueTargetOrder(GetLastCreatedUnit(), "thunderbolt", GetEnumUnit())
    call ShowUnitHide(GetLastCreatedUnit())
endfunction

function Trig_liuxingchuiActions takes nothing returns nothing
    if ( ( GetUnitAbilityLevelSwapped('AHtb', GetTriggerUnit()) == 1 ) ) then
        if ( ( GetRandomInt(1, 10) == 2 ) ) then
            call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(250.00 , GetUnitLoc(GetSpellTargetUnit()) , Condition(function Trig_liuxingchuiFunc001Func003Func001001003)), function Trig_liuxingchuiFunc001Func003Func001A)
            call AddSpecialEffectTargetUnitBJ("hand right", GetTriggerUnit(), "Abilities\\Spells\\Items\\AIvi\\AIviTarget.mdl")
        else
        endif
    else
        if ( ( GetUnitAbilityLevelSwapped('AHtb', GetTriggerUnit()) == 2 ) ) then
            if ( ( GetRandomInt(1, 9) == 2 ) ) then
                call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(250.00 , GetUnitLoc(GetSpellTargetUnit()) , Condition(function Trig_liuxingchuiFunc001Func001Func003Func001001003)), function Trig_liuxingchuiFunc001Func001Func003Func001A)
                call AddSpecialEffectTargetUnitBJ("hand right", GetTriggerUnit(), "Abilities\\Spells\\Items\\AIvi\\AIviTarget.mdl")
                call DestroyEffect(GetLastCreatedEffectBJ())
            else
            endif
        else
            if ( ( GetUnitAbilityLevelSwapped('AHtb', GetTriggerUnit()) == 3 ) ) then
                if ( ( GetRandomInt(1, 8) == 2 ) ) then
                    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(250.00 , GetUnitLoc(GetSpellTargetUnit()) , Condition(function Trig_liuxingchuiFunc001Func001Func001Func003Func001001003)), function Trig_liuxingchuiFunc001Func001Func001Func003Func001A)
                    call AddSpecialEffectTargetUnitBJ("hand right", GetTriggerUnit(), "Abilities\\Spells\\Items\\AIvi\\AIviTarget.mdl")
                    call DestroyEffect(GetLastCreatedEffectBJ())
                else
                endif
            else
                if ( ( GetUnitAbilityLevelSwapped('AHtb', GetTriggerUnit()) == 4 ) ) then
                    if ( ( GetRandomInt(1, 7) == 2 ) ) then
                        call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(250.00 , GetUnitLoc(GetSpellTargetUnit()) , Condition(function Trig_liuxingchuiFunc001Func001Func001Func001Func002Func001001003)), function Trig_liuxingchuiFunc001Func001Func001Func001Func002Func001A)
                        call AddSpecialEffectTargetUnitBJ("hand right", GetTriggerUnit(), "Abilities\\Spells\\Items\\AIvi\\AIviTarget.mdl")
                        call DestroyEffect(GetLastCreatedEffectBJ())
                    else
                    endif
                else
                endif
            endif
        endif
    endif
endfunction

