function Trig_wenConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A06O' ) )
endfunction

function Trig_wenFunc004001003 takes nothing returns boolean
    return ( ( ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true ) and ( IsUnitAliveBJ(GetFilterUnit()) == true ) ) )
endfunction

function Trig_wenFunc004A takes nothing returns nothing
    call UnitDamageTarget(udg_gongjuezhiwen[0], GetEnumUnit(), ( ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_gongjuezhiwen[0]) - GetUnitStateSwap(UNIT_STATE_LIFE, udg_gongjuezhiwen[0]) ) / 8.00 ), true, true, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WOOD_HEAVY_BASH)
    call AddSpecialEffectTargetUnitBJ("chest", GetEnumUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

function Trig_wenActions takes nothing returns nothing
    call SetUnitAnimation(GetTriggerUnit(), "attack")
    call YDWEPolledWaitNull(0.20)
    call SetUnitPositionLoc(GetTriggerUnit(), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 600.00, AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(udg_Target_Random[GetConvertedPlayerId(GetTriggerPlayer())]))))
    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(300.00 , GetUnitLoc(udg_Target_Random[GetConvertedPlayerId(GetTriggerPlayer())]) , Condition(function Trig_wenFunc004001003)), function Trig_wenFunc004A)
    call SetUnitLifeBJ(udg_gongjuezhiwen[0], ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_gongjuezhiwen[0]) + ( ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_gongjuezhiwen[0]) - GetUnitStateSwap(UNIT_STATE_LIFE, udg_gongjuezhiwen[0]) ) / 10.00 ) ))
    call YDWEPolledWaitNull(0.50)
    call RemoveUnit(GetTriggerUnit())
endfunction

