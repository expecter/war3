    call TriggerAddCondition(gg_trg_tianqi_shuiyueren, Condition(function Trig_tianqi_shuiyuerenConditions))
    call TriggerAddAction(gg_trg_tianqi_shuiyueren, function Trig_tianqi_shuiyuerenActions)
