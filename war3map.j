    return ( ( GetSpellAbilityId() == 'A090' ) )
endfunction

function Trig_tianqi_shuiyuerenFunc001001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) )
endfunction

function Trig_tianqi_shuiyuerenFunc001A takes nothing returns nothing
    call UnitDamageTarget(GetTriggerUnit(), GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) / 1.50 ), true, true, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_COLD, WEAPON_TYPE_METAL_LIGHT_CHOP)
    call AddSpecialEffectTargetUnitBJ("chest", GetEnumUnit(), "Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

function Trig_tianqi_shuiyuerenActions takes nothing returns nothing
    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(550.00 , GetUnitLoc(GetLastCreatedUnit()) , Condition(function Trig_tianqi_shuiyuerenFunc001001003)), function Trig_tianqi_shuiyuerenFunc001A)
    call SetUnitLifeBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) / 2.00 ))
    call DestroyGroup(GetLastCreatedGroup())
    call RemoveUnit(GetLastCreatedUnit())
endfunction

