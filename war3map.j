//===========================================================================
// Trigger: miyao
//===========================================================================
function Trig_miyaoConditions takes nothing returns boolean
    return ( ( GetItemTypeId(GetManipulatedItem()) == 'I0AF' ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction

function Trig_miyaoActions takes nothing returns nothing
    call UnitAddAbilityBJ('A0MV', GetTriggerUnit())
    call SetUnitLifePercentBJ(GetTriggerUnit(), 100)
    call AddSpecialEffectLocBJ(GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitLifePercentBJ(GetTriggerUnit(), 100)
        call YDWEPolledWaitNull(1.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call YDWEPolledWaitNull(50.00)
    call UnitRemoveAbilityBJ('A0MV', GetTriggerUnit())
endfunction

//===========================================================================
function InitTrig_miyao takes nothing returns nothing
    set gg_trg_miyao=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_miyao, EVENT_PLAYER_UNIT_USE_ITEM)
    call TriggerAddCondition(gg_trg_miyao, Condition(function Trig_miyaoConditions))
    call TriggerAddAction(gg_trg_miyao, function Trig_miyaoActions)
endfunction

//===========================================================================
// Trigger: yuangumiyao
//===========================================================================
function Trig_yuangumiyaoConditions takes nothing returns boolean
    return ( ( GetItemTypeId(GetManipulatedItem()) == 'I0AH' ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction

function Trig_yuangumiyaoActions takes nothing returns nothing
    call UnitAddAbilityBJ('A0MW', GetTriggerUnit())
    call UnitAddAbilityBJ('A0MD', GetTriggerUnit())
    call SetUnitLifePercentBJ(GetTriggerUnit(), 100)
    call SetUnitManaPercentBJ(GetTriggerUnit(), 100)
    call AddSpecialEffectLocBJ(GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitManaPercentBJ(GetTriggerUnit(), 100)
        call SetUnitLifePercentBJ(GetTriggerUnit(), 100)
        call YDWEPolledWaitNull(1.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=30
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitManaPercentBJ(GetTriggerUnit(), 100)
        call YDWEPolledWaitNull(1.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call YDWEPolledWaitNull(50.00)
    call UnitRemoveAbilityBJ('A0MW', GetTriggerUnit())
    call UnitRemoveAbilityBJ('A0MD', GetTriggerUnit())
endfunction

//===========================================================================
function InitTrig_yuangumiyao takes nothing returns nothing
    set gg_trg_yuangumiyao=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_yuangumiyao, EVENT_PLAYER_UNIT_USE_ITEM)
    call TriggerAddCondition(gg_trg_yuangumiyao, Condition(function Trig_yuangumiyaoConditions))
