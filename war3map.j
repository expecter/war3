function InitTrig_shengguangzuzhou takes nothing returns nothing
    set gg_trg_shengguangzuzhou=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_shengguangzuzhou, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_shengguangzuzhou, Condition(function Trig_shengguangzuzhouConditions))
