//===========================================================================
// Trigger: shenlinliliang
//===========================================================================
function Trig_shenlinliliangConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0OV' ) )
endfunction

function Trig_shenlinliliangActions takes nothing returns nothing
    if ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0OV') == 1 ) ) then
        call UnitAddAbilityBJ('A0OW', GetTriggerUnit())
        call YDWEPolledWaitNull(20.00)
        call UnitRemoveAbilityBJ('A0OW', GetTriggerUnit())
    else
    endif
    if ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0OV') == 2 ) ) then
        call UnitAddAbilityBJ('A0OX', GetTriggerUnit())
        call YDWEPolledWaitNull(30.00)
        call UnitRemoveAbilityBJ('A0OX', GetTriggerUnit())
    else
    endif
    if ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0OV') == 3 ) ) then
        call UnitAddAbilityBJ('A0OY', GetTriggerUnit())
        call YDWEPolledWaitNull(40.00)
        call UnitRemoveAbilityBJ('A0OY', GetTriggerUnit())
    else
    endif
    if ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0OV') == 4 ) ) then
        call UnitAddAbilityBJ('A0OZ', GetTriggerUnit())
        call YDWEPolledWaitNull(50.00)
        call UnitRemoveAbilityBJ('A0OZ', GetTriggerUnit())
    else
    endif
endfunction

