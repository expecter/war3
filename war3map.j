//===========================================================================
// Trigger: yanshengji
//===========================================================================
function Trig_yanshengjiActions takes nothing returns nothing
    if ( ( GetUnitAbilityLevelSwapped('A0HY', gg_unit_H001_0524) < 20 ) ) then
        call IncUnitAbilityLevelSwapped('A0HY', gg_unit_H001_0524)
        call IncUnitAbilityLevelSwapped('A0I0', gg_unit_H001_0524)
        call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 30, "TRIGSTR_5643")
    else
        call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 30, "TRIGSTR_5644")
        call DisableTrigger(GetTriggeringTrigger())
    endif
endfunction

