//===========================================================================
// Trigger: momian
//===========================================================================
function Trig_momianConditions takes nothing returns boolean
    return ( ( GetResearched() == 'R00H' ) )
endfunction

function Trig_momianFunc002001002 takes nothing returns boolean
    return ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false ) )
endfunction

function Trig_momianFunc003002 takes nothing returns nothing
    call UnitAddAbilityBJ('A0OE', GetEnumUnit())
endfunction

function Trig_momianActions takes nothing returns nothing
    set udg_momian=CreateGroup()
    call GroupAddGroup(YDWEGetUnitsOfPlayerMatchingNull(GetTriggerPlayer() , Condition(function Trig_momianFunc002001002)), udg_momian)
    call ForGroupBJ(udg_momian, function Trig_momianFunc003002)
    call ForceAddPlayerSimple(GetTriggerPlayer(), udg_momianwanjiazu)
    call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 30, "TRIGSTR_4280")
endfunction

//===========================================================================
function InitTrig_momian takes nothing returns nothing
    set gg_trg_momian=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_momian, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_momian, Condition(function Trig_momianConditions))
    call TriggerAddAction(gg_trg_momian, function Trig_momianActions)
endfunction

