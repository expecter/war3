//===========================================================================
// Trigger: chushibiangliang
//===========================================================================
function Trig_chushibiangliangConditions takes nothing returns boolean
    return ( ( ( GetUnitTypeId(GetTriggerUnit()) == 'owtw' ) or ( GetUnitTypeId(GetTriggerUnit()) == 'uzig' ) or ( GetUnitTypeId(GetTriggerUnit()) == 'etrp' ) ) and ( IsPlayerInForce(GetTriggerPlayer(), udg_bianliang) == false ) )
endfunction

function Trig_chushibiangliangActions takes nothing returns nothing
    set udg_shengji[GetConvertedPlayerId(GetTriggerPlayer())]=0
    call ForceAddPlayerSimple(GetTriggerPlayer(), udg_bianliang)
endfunction

//===========================================================================
function InitTrig_chushibiangliang takes nothing returns nothing
    set gg_trg_chushibiangliang=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_chushibiangliang, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
    call TriggerAddCondition(gg_trg_chushibiangliang, Condition(function Trig_chushibiangliangConditions))
    call TriggerAddAction(gg_trg_chushibiangliang, function Trig_chushibiangliangActions)
endfunction

