//===========================================================================
// Trigger: siwangzuhe
//===========================================================================
function Trig_siwangzuheConditions takes nothing returns boolean
    return ( ( UnitHasItemOfTypeBJ(GetAttacker(), 'I02X') == true ) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I00Z') == true ) and ( IsUnitIllusionBJ(GetAttacker()) == false ) and ( IsUnitIllusionBJ(GetTriggerUnit()) == false ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == false ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false ) and ( GetUnitTypeId(GetTriggerUnit()) != 'uarb' ) )
endfunction

function Trig_siwangzuheActions takes nothing returns nothing
    if ( ( GetRandomInt(1, 10) == 1 ) ) then
        call SetUnitOwner(GetTriggerUnit(), GetOwningPlayer(GetAttacker()), true)
        if ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_FLYING) == false ) ) then
            if ( ( GetRandomInt(1, 10) == 1 ) ) then
                call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'nowk' , bj_UNIT_STATE_METHOD_RELATIVE)
            else
                if ( ( GetRandomInt(1, 10) == 2 ) ) then
                    call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'nerw' , bj_UNIT_STATE_METHOD_RELATIVE)
                else
                    if ( ( GetRandomInt(1, 10) == 3 ) ) then
                        call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'nbal' , bj_UNIT_STATE_METHOD_RELATIVE)
                    else
                        if ( ( GetRandomInt(1, 10) == 4 ) ) then
                            call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'nhhr' , bj_UNIT_STATE_METHOD_RELATIVE)
                        else
                            if ( ( GetRandomInt(1, 10) == 5 ) ) then
                                call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'nrvd' , bj_UNIT_STATE_METHOD_RELATIVE)
                            else
                                if ( ( GetRandomInt(1, 10) == 6 ) ) then
                                    call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'nsth' , bj_UNIT_STATE_METHOD_RELATIVE)
                                else
                                    if ( ( GetRandomInt(1, 10) == 7 ) ) then
                                        call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'nfod' , bj_UNIT_STATE_METHOD_RELATIVE)
                                    else
                                        if ( ( GetRandomInt(1, 10) == 8 ) ) then
                                            call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'nano' , bj_UNIT_STATE_METHOD_RELATIVE)
                                        else
                                            if ( ( GetRandomInt(1, 10) == 9 ) ) then
                                                call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'n029' , bj_UNIT_STATE_METHOD_RELATIVE)
                                            else
                                                call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'n023' , bj_UNIT_STATE_METHOD_RELATIVE)
                                            endif
                                        endif
                                    endif
                                endif
                            endif
                        endif
                    endif
                endif
            endif
        else
        endif
        call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
    else
    endif
endfunction

//===========================================================================
function InitTrig_siwangzuhe takes nothing returns nothing
    set gg_trg_siwangzuhe=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_siwangzuhe, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_siwangzuhe, Condition(function Trig_siwangzuheConditions))
    call TriggerAddAction(gg_trg_siwangzuhe, function Trig_siwangzuheActions)
endfunction

//===========================================================================
// Trigger: chicao
//===========================================================================
function Trig_chicaoConditions takes nothing returns boolean
    return ( ( ( GetItemTypeId(GetManipulatedItem()) == 'I01F' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I08O' ) ) and ( ( GetUnitTypeId(GetTriggerUnit()) == 'h00Q' ) or ( GetUnitTypeId(GetTriggerUnit()) == 'h015' ) ) )
endfunction

function Trig_chicaoActions takes nothing returns nothing
    call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(GetManipulatedItem())))
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'h00Q' ) ) then
        if ( ( GetUnitMoveSpeed(GetTriggerUnit()) <= 500.00 ) ) then
            if ( ( GetRandomInt(1, 3) == 2 ) ) then
                call SetUnitMoveSpeed(GetTriggerUnit(), ( GetUnitMoveSpeed(GetTriggerUnit()) - 30.00 ))
                call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 10.00, ( "绵羊当前移动速度为" + ( R2S(GetUnitMoveSpeed(GetTriggerUnit())) + "。" ) ))
            else
                call SetUnitMoveSpeed(GetTriggerUnit(), ( GetUnitMoveSpeed(GetTriggerUnit()) + 20.00 ))
                call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 10.00, ( "绵羊当前移动速度为" + ( R2S(GetUnitMoveSpeed(GetTriggerUnit())) + "。" ) ))
            endif
        else
            call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 10.00, "TRIGSTR_6988")
            call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 20.00, "TRIGSTR_8868")
            call CreateNUnitsAtLoc(1, 'h015', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
            call KillUnit(GetTriggerUnit())
        endif
    else
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'h015' ) ) then
        if ( ( GetUnitMoveSpeed(GetTriggerUnit()) <= 500.00 ) ) then
            if ( ( GetRandomInt(1, 3) == 2 ) ) then
                call SetUnitMoveSpeed(GetTriggerUnit(), ( GetUnitMoveSpeed(GetTriggerUnit()) - 30.00 ))
                call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 10.00, ( "绵羊当前移动速度为" + ( R2S(GetUnitMoveSpeed(GetTriggerUnit())) + "。" ) ))
            else
                call SetUnitMoveSpeed(GetTriggerUnit(), ( GetUnitMoveSpeed(GetTriggerUnit()) + 20.00 ))
                call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 10.00, ( "绵羊当前移动速度为" + ( R2S(GetUnitMoveSpeed(GetTriggerUnit())) + "。" ) ))
            endif
        else
            if ( ( GetRandomInt(1, 8) == 4 ) ) then
                call CreateNUnitsAtLoc(1, 'h016', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
                call KillUnit(GetTriggerUnit())
                call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 10.00, "TRIGSTR_6989")
                call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 20.00, "TRIGSTR_8869")
            else
                call CreateItemLoc('shrs', GetUnitLoc(GetTriggerUnit()))
                call KillUnit(GetTriggerUnit())
                call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 10.00, "TRIGSTR_6990")
            endif
        endif
    else
    endif
endfunction

