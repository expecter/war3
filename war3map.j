// Trigger: nuzhiren gongji
//===========================================================================
function Trig_nuzhiren_gongjiConditions takes nothing returns boolean
    return ( ( UnitHasItemOfTypeBJ(GetAttacker(), 'I00N') == true ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(GetTriggerUnit()))) <= 280 ) and ( IsUnitIllusionBJ(GetAttacker()) == false ) )
endfunction

function Trig_nuzhiren_gongjiActions takes nothing returns nothing
    call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), 40.00, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

//===========================================================================
function InitTrig_nuzhiren_gongji takes nothing returns nothing
    set gg_trg_nuzhiren_gongji=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_nuzhiren_gongji, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_nuzhiren_gongji, Condition(function Trig_nuzhiren_gongjiConditions))
    call TriggerAddAction(gg_trg_nuzhiren_gongji, function Trig_nuzhiren_gongjiActions)
endfunction

//===========================================================================
// Trigger: nuzhirenv gongji
//===========================================================================
function Trig_nuzhirenv_gongjiConditions takes nothing returns boolean
    return ( ( UnitHasItemOfTypeBJ(GetAttacker(), 'I08P') == true ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(GetTriggerUnit()))) <= 280 ) and ( IsUnitIllusionBJ(GetAttacker()) == false ) )
endfunction

function Trig_nuzhirenv_gongjiFunc004Func001001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetAttacker())) == true ) )
endfunction

function Trig_nuzhirenv_gongjiFunc004Func001A takes nothing returns nothing
    call UnitDamageTarget(GetAttacker(), GetEnumUnit(), 200.00, true, true, ATTACK_TYPE_HERO, DAMAGE_TYPE_FIRE, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

function Trig_nuzhirenv_gongjiActions takes nothing returns nothing
    call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), 60.00, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    if ( ( GetRandomInt(1, 6) == 6 ) ) then
        call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(200.00 , GetUnitLoc(GetTriggerUnit()) , Condition(function Trig_nuzhirenv_gongjiFunc004Func001001003)), function Trig_nuzhirenv_gongjiFunc004Func001A)
    else
    endif
endfunction

//===========================================================================
function InitTrig_nuzhirenv_gongji takes nothing returns nothing
    set gg_trg_nuzhirenv_gongji=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_nuzhirenv_gongji, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_nuzhirenv_gongji, Condition(function Trig_nuzhirenv_gongjiConditions))
    call TriggerAddAction(gg_trg_nuzhirenv_gongji, function Trig_nuzhirenv_gongjiActions)
endfunction

