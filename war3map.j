//===========================================================================
// Trigger: siwangjinhua
//===========================================================================
function Trig_siwangjinhuaConditions takes nothing returns boolean
    return ( ( GetLearnedSkillBJ() == 'A0PJ' ) )
endfunction

function Trig_siwangjinhuaActions takes nothing returns nothing
    call UnitAddAbilityBJ('A0PK', GetLearningUnit())
    call UnitMakeAbilityPermanent(GetLearningUnit(), true, 'A0PK')
    call SetUnitScale(GetLearningUnit(), 1.30, 1.30, 1.30)
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "war3mapImported\\CannonadeBomb.mdx")
    call DestroyEffect(GetLastCreatedEffectBJ())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitVertexColorBJ(GetTriggerUnit(), ( 100.00 - ( 3.00 * I2R(GetForLoopIndexA()) ) ), ( 100.00 - ( 3.00 * I2R(GetForLoopIndexA()) ) ), 100.00, 0.00)
        call YDWEPolledWaitNull(0.20)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitVertexColorBJ(GetLearningUnit(), 60.00, 60.00, 100.00, 0.00)
endfunction

//===========================================================================
function InitTrig_siwangjinhua takes nothing returns nothing
    set gg_trg_siwangjinhua=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_siwangjinhua, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(gg_trg_siwangjinhua, Condition(function Trig_siwangjinhuaConditions))
    call TriggerAddAction(gg_trg_siwangjinhua, function Trig_siwangjinhuaActions)
endfunction

