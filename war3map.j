function InitTrig_beigongji4 takes nothing returns nothing
    set gg_trg_beigongji4=CreateTrigger()
    call TriggerRegisterUnitEvent(gg_trg_beigongji4, gg_unit_o000_0280, EVENT_UNIT_ATTACKED)
    call TriggerAddAction(gg_trg_beigongji4, function Trig_beigongji4Actions)
endfunction

