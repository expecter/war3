    call SetUnitPositionLoc(udg_Z[3], PolarProjectionBJ(GetUnitLoc(udg_Z[3]), 35.00, GetUnitFacing(udg_Z[3])))
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Z[1]), "Abilities\\Weapons\\BoatMissile\\BoatMissile.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(300.00 , GetUnitLoc(udg_Z[1]) , Condition(function Trig_zhanlongjue2Func006001003)), function Trig_zhanlongjue2Func006A)
