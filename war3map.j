function InitTrig_jinjilingjian takes nothing returns nothing
    set gg_trg_jinjilingjian=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_jinjilingjian, EVENT_PLAYER_UNIT_USE_ITEM)
    call TriggerAddCondition(gg_trg_jinjilingjian, Condition(function Trig_jinjilingjianConditions))
