endfunction

function Trig_luoyuegongFunc003001 takes nothing returns boolean
    return ( ( UnitHasBuffBJ(udg_luoyuegong, 'B004') == true ) )
endfunction

function Trig_luoyuegongActions takes nothing returns nothing
    set udg_luoyuegong=GetSpellTargetUnit()
    call AddSpecialEffectTargetUnitBJ("weapon", GetTriggerUnit(), "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")
    loop
        exitwhen ( (UnitHasBuffBJ(udg_luoyuegong, 'B004') == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    call UnitDamageTarget(GetTriggerUnit(), udg_luoyuegong, DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(udg_luoyuegong)), true, true, ATTACK_TYPE_PIERCE, DAMAGE_TYPE_POISON, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("chest", udg_luoyuegong, "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

