//===========================================================================
// Trigger: chaoxibailiezhan
//===========================================================================
function Trig_chaoxibailiezhanConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0OJ' ) )
endfunction

function Trig_chaoxibailiezhanFunc001Func003001 takes nothing returns boolean
    return ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B03M') == false ) )
endfunction

function Trig_chaoxibailiezhanFunc001Func008001 takes nothing returns boolean
    return ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B03M') == false ) )
endfunction

function Trig_chaoxibailiezhanActions takes nothing returns nothing
    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I02R') == true ) ) then
        call UnitAddAbilityBJ('A0OL', GetTriggerUnit())
        call YDWEPolledWaitNull(1.00)
        loop
            exitwhen ( (UnitHasBuffBJ(GetTriggerUnit(), 'B03M') == false) ) // INLINED!!
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
        endloop
        call UnitRemoveAbilityBJ('A0OL', GetTriggerUnit())
    else
        call UnitAddAbilityBJ('A0OK', GetTriggerUnit())
        call YDWEPolledWaitNull(1.00)
        loop
            exitwhen ( (UnitHasBuffBJ(GetTriggerUnit(), 'B03M') == false) ) // INLINED!!
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
        endloop
        call UnitRemoveAbilityBJ('A0OK', GetTriggerUnit())
    endif
endfunction

//===========================================================================
function InitTrig_chaoxibailiezhan takes nothing returns nothing
    set gg_trg_chaoxibailiezhan=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_chaoxibailiezhan, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_chaoxibailiezhan, Condition(function Trig_chaoxibailiezhanConditions))
    call TriggerAddAction(gg_trg_chaoxibailiezhan, function Trig_chaoxibailiezhanActions)
endfunction

//===========================================================================
// Trigger: biboguanghuan
//===========================================================================
function Trig_biboguanghuanConditions takes nothing returns boolean
    return ( ( UnitHasBuffBJ(GetAttacker(), 'B03N') == true ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(GetTriggerUnit()))) <= 300 ) )
endfunction

function Trig_biboguanghuanActions takes nothing returns nothing
    call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), ( 10.00 * I2R(udg_biboguanghuan) ), true, true, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

//===========================================================================
function InitTrig_biboguanghuan takes nothing returns nothing
    set gg_trg_biboguanghuan=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_biboguanghuan, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_biboguanghuan, Condition(function Trig_biboguanghuanConditions))
    call TriggerAddAction(gg_trg_biboguanghuan, function Trig_biboguanghuanActions)
endfunction

