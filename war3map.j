//===========================================================================
// Trigger: faqian
//===========================================================================
function Trig_faqianActions takes nothing returns nothing
    call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 10.00, "TRIGSTR_3390")
    call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 15.00, ( "所有玩家获得" + ( I2S(( 200 + ( GetPlayerState(Player(11), PLAYER_STATE_RESOURCE_GOLD) / 10 ) )) + "个金币。" ) ))
    call AdjustPlayerStateBJ(( 200 + ( GetPlayerState(Player(11), PLAYER_STATE_RESOURCE_GOLD) / 10 ) ), Player(0), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(( 200 + ( GetPlayerState(Player(11), PLAYER_STATE_RESOURCE_GOLD) / 10 ) ), Player(1), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(( 200 + ( GetPlayerState(Player(11), PLAYER_STATE_RESOURCE_GOLD) / 10 ) ), Player(2), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(( 200 + ( GetPlayerState(Player(11), PLAYER_STATE_RESOURCE_GOLD) / 10 ) ), Player(3), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(( 200 + ( GetPlayerState(Player(11), PLAYER_STATE_RESOURCE_GOLD) / 10 ) ), Player(4), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(( 200 + ( GetPlayerState(Player(11), PLAYER_STATE_RESOURCE_GOLD) / 10 ) ), Player(5), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(( 200 + ( GetPlayerState(Player(11), PLAYER_STATE_RESOURCE_GOLD) / 10 ) ), Player(6), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(( 200 + ( GetPlayerState(Player(11), PLAYER_STATE_RESOURCE_GOLD) / 10 ) ), Player(7), PLAYER_STATE_RESOURCE_GOLD)
endfunction

