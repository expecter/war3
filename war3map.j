    call TriggerRegisterAnyUnitEventBJ(gg_trg_shizigonggj, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_shizigonggj, Condition(function Trig_shizigonggjConditions))
