//===========================================================================
// Trigger: liliangtisheng
//===========================================================================
function Trig_liliangtishengConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A05R' ) )
endfunction

function Trig_liliangtishengActions takes nothing returns nothing
    if ( ( GetUnitAbilityLevelSwapped('A05R', GetTriggerUnit()) == 1 ) ) then
        call UnitAddAbilityBJ('A01P', GetTriggerUnit())
        call YDWEPolledWaitNull(30.00)
        call UnitRemoveAbilityBJ('A01P', GetTriggerUnit())
    else
        if ( ( GetUnitAbilityLevelSwapped('A05R', GetTriggerUnit()) == 2 ) ) then
            call UnitAddAbilityBJ('A03W', GetTriggerUnit())
            call YDWEPolledWaitNull(30.00)
            call UnitRemoveAbilityBJ('A03W', GetTriggerUnit())
        else
            if ( ( GetUnitAbilityLevelSwapped('A05R', GetTriggerUnit()) == 3 ) ) then
                call UnitAddAbilityBJ('A0AQ', GetTriggerUnit())
                call YDWEPolledWaitNull(30.00)
                call UnitRemoveAbilityBJ('A0AQ', GetTriggerUnit())
            else
                if ( ( GetUnitAbilityLevelSwapped('A05R', GetTriggerUnit()) == 4 ) ) then
                    call UnitAddAbilityBJ('A0O1', GetTriggerUnit())
                    call YDWEPolledWaitNull(30.00)
                    call UnitRemoveAbilityBJ('A0O1', GetTriggerUnit())
                else
                endif
            endif
        endif
    endif
endfunction

