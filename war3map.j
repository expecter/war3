//===========================================================================
function Trig_dadizhizhuaConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0CU' ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction

function Trig_dadizhizhuaFunc001Func011001003 takes nothing returns boolean
    return ( ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) and ( IsUnitAliveBJ(GetFilterUnit()) == true ) ) )
endfunction

function Trig_dadizhizhuaFunc001Func011A takes nothing returns nothing
    call AddSpecialEffectLocBJ(GetUnitLoc(GetEnumUnit()), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

function Trig_dadizhizhuaActions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'e00A', GetOwningPlayer(GetTriggerUnit()), GetSpellTargetLoc(), bj_UNIT_FACING)
        call SetUnitScalePercent(GetLastCreatedUnit(), 200.00, 200.00, 200.00)
        call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
        call UnitAddAbilityBJ('A0CP', GetLastCreatedUnit())
        call SetUnitAbilityLevelSwapped('A0CP', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0CU', GetTriggerUnit()))
        call IssuePointOrderLoc(GetLastCreatedUnit(), "impale", PolarProjectionBJ(GetSpellTargetLoc(), 256, ( 60.00 * I2R(GetForLoopIndexA()) )))
        call AddSpecialEffectLocBJ(GetSpellTargetLoc(), "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call AddSpecialEffectLocBJ(GetSpellTargetLoc(), "Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(400.00 , GetSpellTargetLoc() , Condition(function Trig_dadizhizhuaFunc001Func011001003)), function Trig_dadizhizhuaFunc001Func011A)
        call ShowUnitHide(GetLastCreatedUnit())
        call DestroyGroup(GetLastCreatedGroup())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

