//===========================================================================
// Trigger: gongjuezhiwen
//===========================================================================
function Trig_gongjuezhiwenConditions takes nothing returns boolean
    return ( ( ( GetSpellAbilityId() == 'A00I' ) or ( GetSpellAbilityId() == 'A0JS' ) ) )
endfunction

function Trig_gongjuezhiwenFunc011001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true ) )
endfunction

function Trig_gongjuezhiwenFunc011A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'e00A', GetTriggerPlayer(), GetUnitLoc(udg_gongjuezhiwen4), bj_UNIT_FACING)
    call ShowUnitHide(GetLastCreatedUnit())
    call UnitAddAbilityBJ('AUsl', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('AUsl', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('AUsl', GetTriggerUnit()))
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
    call IssueTargetOrder(GetLastCreatedUnit(), "sleep", GetEnumUnit())
endfunction

function Trig_gongjuezhiwenFunc016Func001002003 takes nothing returns boolean
    return ( ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false ) and ( ( IsUnitAliveBJ(GetFilterUnit()) == true ) and ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_gongjuezhiwen[0])) == true ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_GROUND) == true ) ) ) ) )
endfunction

function Trig_gongjuezhiwenActions takes nothing returns nothing
    set udg_gongjuezhiwen[0]=GetTriggerUnit()
    set udg_gongjuezhiwen2[0]=GetUnitLoc(GetSpellTargetUnit())
    set udg_gongjuezhiwen3=GetUnitFacing(udg_gongjuezhiwen[0])
    set udg_gongjuezhiwen4=GetSpellTargetUnit()
    call YDWEPolledWaitNull(0.10)
    call CreateNUnitsAtLoc(1, 'n018', GetTriggerPlayer(), GetUnitLoc(udg_gongjuezhiwen[0]), udg_gongjuezhiwen3)
    call SetUnitInvulnerable(udg_gongjuezhiwen[0], true)
    call ShowUnitHide(udg_gongjuezhiwen[0])
    set udg_gongjuezhiwen[1]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_gongjuezhiwen[1], "death")
    call ForGroupBJ(YDWEGetUnitsInRangeOfLocMatchingNull(400.00 , GetUnitLoc(udg_gongjuezhiwen4) , Condition(function Trig_gongjuezhiwenFunc011001003)), function Trig_gongjuezhiwenFunc011A)
    call RemoveUnit(GetLastCreatedUnit())
    call DestroyGroup(GetLastCreatedGroup())
    call YDWEPolledWaitNull(1.70)
    call RemoveUnit(udg_gongjuezhiwen[1])
    set bj_forLoopAIndex=0
    set bj_forLoopAIndexEnd=R2I(( 5.00 + I2R(GetUnitLevel(udg_gongjuezhiwen[0])) ))
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Blink_Storm_Targets[GetConvertedPlayerId(GetTriggerPlayer())]=YDWEGetUnitsInRangeOfLocMatchingNull(600.00 , udg_gongjuezhiwen2[0] , Condition(function Trig_gongjuezhiwenFunc016Func001002003))
        if ( ( IsUnitGroupEmptyBJ(udg_Blink_Storm_Targets[GetConvertedPlayerId(GetTriggerPlayer())]) == false ) and ( IsUnitAliveBJ(udg_gongjuezhiwen[0]) == true ) ) then
            set udg_Target_Random[GetConvertedPlayerId(GetTriggerPlayer())]=GroupPickRandomUnit(udg_Blink_Storm_Targets[GetConvertedPlayerId(GetTriggerPlayer())])
            call CreateNUnitsAtLoc(1, 'n019', GetTriggerPlayer(), PolarProjectionBJ(GetUnitLoc(udg_Target_Random[GetConvertedPlayerId(GetTriggerPlayer())]), 350.00, GetRandomDirectionDeg()), GetRandomDirectionDeg())
            call AddSpecialEffectTargetUnitBJ("weapon", GetLastCreatedUnit(), "Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl")
            call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
            call IssueTargetOrder(GetLastCreatedUnit(), "thunderbolt", udg_Target_Random[GetConvertedPlayerId(GetTriggerPlayer())])
            call YDWEPolledWaitNull(0.10)
        else
            call DoNothing()
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitPositionLoc(udg_gongjuezhiwen[0], GetUnitLoc(udg_Target_Random[GetConvertedPlayerId(GetTriggerPlayer())]))
    call ShowUnitShow(udg_gongjuezhiwen[0])
    call SetUnitVertexColor(udg_gongjuezhiwen[0], 0, 0, 0, 255)
    call AddSpecialEffectTargetUnitBJ("chest", udg_gongjuezhiwen[0], "war3mapImported\\DarkPulse.mdx")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call SetUnitAnimation(udg_gongjuezhiwen[0], "spell slam")
    call YDWEPolledWaitNull(2.00)
    call SetUnitInvulnerable(udg_gongjuezhiwen[0], false)
    set bj_forLoopAIndex=0
    set bj_forLoopAIndexEnd=9
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RemoveUnit(udg_gongjuezhiwen[( bj_forLoopAIndex + 2 )])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitVertexColor(udg_gongjuezhiwen[0], 255, 255, 255, 255)
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

//===========================================================================
function InitTrig_gongjuezhiwen takes nothing returns nothing
    set gg_trg_gongjuezhiwen=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_gongjuezhiwen, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_gongjuezhiwen, Condition(function Trig_gongjuezhiwenConditions))
    call TriggerAddAction(gg_trg_gongjuezhiwen, function Trig_gongjuezhiwenActions)
endfunction

