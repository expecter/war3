endfunction

function Trig_chongshengActions takes nothing returns nothing
    call ReviveHeroLoc(GetTriggerUnit(), udg_mubei2[GetConvertedPlayerId(GetTriggerPlayer())], true)
    call PanCameraToTimedLocForPlayer(GetTriggerPlayer(), OffsetLocation(udg_mubei2[GetConvertedPlayerId(GetTriggerPlayer())], 0, 0), 0)
    call SetUnitManaPercentBJ(GetTriggerUnit(), 100)
    call SetUnitInvulnerable(GetTriggerUnit(), true)
    call YDWEPolledWaitNull(5.00)
    call SetUnitInvulnerable(GetTriggerUnit(), false)
endfunction

