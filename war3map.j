//===========================================================================
// Trigger: niutouren
//===========================================================================
function Trig_niutourenConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A07M' ) )
endfunction

function Trig_niutourenActions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call CreateNUnitsAtLoc(1, 'n01G', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    set udg_zhendangbo[GetConvertedPlayerId(GetTriggerPlayer())]=GetLastCreatedUnit()
    set udg_zhendangbo2[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetLoc()
    call UnitAddAbilityBJ('AOsh', udg_zhendangbo[GetConvertedPlayerId(GetTriggerPlayer())])
    call SetUnitAbilityLevelSwapped('AOsh', udg_zhendangbo[GetConvertedPlayerId(GetTriggerPlayer())], GetUnitAbilityLevelSwapped('A07M', GetTriggerUnit()))
    call IssuePointOrderLoc(udg_zhendangbo[GetConvertedPlayerId(GetTriggerPlayer())], "shockwave", udg_zhendangbo2[GetConvertedPlayerId(GetTriggerPlayer())])
    call YDWEPolledWaitNull(0.10)
    call UnitAddAbilityBJ('AOs2', udg_zhendangbo[GetConvertedPlayerId(GetTriggerPlayer())])
    call SetUnitAbilityLevelSwapped('AOs2', udg_zhendangbo[GetConvertedPlayerId(GetTriggerPlayer())], GetUnitAbilityLevelSwapped('A07M', GetTriggerUnit()))
    call IssuePointOrderLoc(udg_zhendangbo[GetConvertedPlayerId(GetTriggerPlayer())], "shockwave", udg_zhendangbo2[GetConvertedPlayerId(GetTriggerPlayer())])
    call RemoveUnit(udg_zhendangbo[GetConvertedPlayerId(GetTriggerPlayer())])
    call RemoveLocation(udg_zhendangbo2[GetConvertedPlayerId(GetTriggerPlayer())])
endfunction

