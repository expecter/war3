//===========================================================================
// Trigger: shuangji
//
// 判断两次点击的事件的时间差
//===========================================================================
function Trig_shuangjiActions takes nothing returns nothing
    if ( ( udg_shuangji > 0 ) ) then
        // 超过时间减少记录次数
        set udg_shuangji=( udg_shuangji - 1 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_shuangji takes nothing returns nothing
    set gg_trg_shuangji=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_shuangji, 0.20)
    call TriggerAddAction(gg_trg_shuangji, function Trig_shuangjiActions)
