//===========================================================================
// Trigger: huangyao
//===========================================================================
function Trig_huangyaoConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0DX' ) )
endfunction

function Trig_huangyaoActions takes nothing returns nothing
    set udg_huangyao[1]=GetSpellTargetUnit()
    call SetUnitPositionLoc(udg_huangyao[1], PolarProjectionBJ(GetUnitLoc(udg_huangyao[1]), 300.00, AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(udg_huangyao[1]))))
    call AddSpecialEffectTargetUnitBJ("weapon", GetTriggerUnit(), "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call SetUnitFacing(GetTriggerUnit(), AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit())))
    call CreateNUnitsAtLoc(1, 'n012', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A0DY', GetLastCreatedUnit())
    call ShowUnitHide(GetLastCreatedUnit())
    set udg_huangyao[0]=GetLastCreatedUnit()
    call SetUnitAbilityLevelSwapped('A0DY', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0DX', GetTriggerUnit()))
    call YDWEPolledWaitNull(0.50)
    call PauseUnitBJ(true, GetTriggerUnit())
    call SetUnitAnimation(GetTriggerUnit(), "attack alternate")
    call IssueNeutralPointOrder(GetTriggerPlayer(), udg_huangyao[0], "clusterrockets", GetLocationX(GetUnitLoc(udg_huangyao[1])), GetLocationY(GetUnitLoc(udg_huangyao[1])))
    call YDWEPolledWaitNull(1.00)
    call PauseUnitBJ(false, GetTriggerUnit())
    call RemoveUnit(udg_huangyao[0])
endfunction

