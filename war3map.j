    call CreateNUnitsAtLoc(1, 'e00A', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    call SetUnitScalePercent(GetLastCreatedUnit(), 200.00, 200.00, 200.00)
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('AOsh', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('AOsh', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0CU', GetTriggerUnit()))
    call IssuePointOrderLoc(GetLastCreatedUnit(), "shockwave", GetSpellTargetLoc())
    call AddSpecialEffectLocBJ(GetSpellTargetLoc(), "Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call ShowUnitHide(GetLastCreatedUnit())
