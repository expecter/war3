    set gg_trg_shendebaohu2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_shendebaohu2, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_shendebaohu2, Condition(function Trig_shendebaohu2Conditions))
    call TriggerAddAction(gg_trg_shendebaohu2, function Trig_shendebaohu2Actions)
endfunction

