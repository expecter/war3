    return ( ( UnitHasItemOfTypeBJ(GetKillingUnitBJ(), 'I06L') == true ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) and ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetKillingUnitBJ(), 'I06L')) < ( 10 + udg_fujiadengji ) ) and ( IsUnitEnemy(GetTriggerUnit(), Player(11)) == true ) )
