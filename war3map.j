//===========================================================================
// Trigger: tianqi
//===========================================================================
function Trig_tianqiActions takes nothing returns nothing
    call RemoveWeatherEffect(GetLastCreatedWeatherEffect())
    call DisableTrigger(gg_trg_quntishengguang_sun)
    call DisableTrigger(gg_trg_quntibingshuang_snow)
    call DisableTrigger(gg_trg_baofengxuejiaqiang)
    call DisableTrigger(gg_trg_tianqi_shuiyueren)
    call DisableTrigger(gg_trg_baofengxuejiaqiang_2)
    call EnableTrigger(gg_trg_huojian)
    call EnableTrigger(gg_trg_huojian_yongzhehuizhang)
    if ( ( GetRandomInt(1, 5) == 2 ) ) then
        call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'RAhr')
        call DisableTrigger(gg_trg_huojian)
        call DisableTrigger(gg_trg_huojian_yongzhehuizhang)
        call EnableTrigger(gg_trg_tianqi_shuiyueren)
        call EnableTrigger(gg_trg_baofengxuejiaqiang_2)
        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_062")
        call YDWEPolledWaitNull(3.00)
        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_063")
        call YDWEPolledWaitNull(3.00)
        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_064")
        call YDWEPolledWaitNull(3.00)
        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_065")
    else
        if ( ( GetRandomInt(1, 3) == 2 ) ) then
            call EnableTrigger(gg_trg_tianqi_shuiyueren)
            call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'RAlr')
            call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_045")
            call YDWEPolledWaitNull(3.00)
            call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_046")
        else
            if ( ( GetRandomInt(1, 3) == 2 ) ) then
                call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'FDbl')
                call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_061")
            else
                if ( ( GetRandomInt(1, 6) == 2 ) ) then
                    call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'FDbh')
                    call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_060")
                else
                    if ( ( GetRandomInt(1, 4) == 2 ) ) then
                        call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'SNbs')
                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_056")
                        call EnableTrigger(gg_trg_quntibingshuang_snow)
                        call EnableTrigger(gg_trg_baofengxuejiaqiang)
                        call EnableTrigger(gg_trg_tianqi_shuiyueren)
                        call YDWEPolledWaitNull(3.00)
                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_057")
                        call YDWEPolledWaitNull(3.00)
                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_058")
                        call YDWEPolledWaitNull(3.00)
                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_059")
                    else
                        if ( ( GetRandomInt(1, 4) == 2 ) ) then
                            call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'SNls')
                            call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_053")
                            call EnableTrigger(gg_trg_quntibingshuang_snow)
                            call EnableTrigger(gg_trg_tianqi_shuiyueren)
                            call YDWEPolledWaitNull(3.00)
                            call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_054")
                            call YDWEPolledWaitNull(3.00)
                            call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_055")
                        else
                            if ( ( GetRandomInt(1, 3) == 2 ) ) then
                                call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'LRaa')
                                call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_051")
                                call EnableTrigger(gg_trg_quntishengguang_sun)
                                call YDWEPolledWaitNull(3.00)
                                call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_052")
                            else
                                if ( ( GetRandomInt(1, 3) == 2 ) ) then
                                    call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'LRma')
                                    call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_050")
                                    call CreateNUnitsAtLoc(1, 'n012', Player(PLAYER_NEUTRAL_AGGRESSIVE), Location(0, 0), bj_UNIT_FACING)
                                    call UnitAddAbilityBJ('A09F', GetLastCreatedUnit())
                                    call IssueImmediateOrderById(GetLastCreatedUnit(), 852621)
                                    call RemoveUnit(GetLastCreatedUnit())
                                else
                                    if ( ( GetRandomInt(1, 5) == 2 ) ) then
                                        call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'WNcw')
                                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_048")
                                        call YDWEPolledWaitNull(3.00)
                                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_049")
                                        call CreateNUnitsAtLoc(1, 'n01H', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(GetPlayableMapRect()), bj_UNIT_FACING)
                                        call CreateNUnitsAtLoc(1, 'n01H', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(GetPlayableMapRect()), bj_UNIT_FACING)
                                        call CreateNUnitsAtLoc(1, 'n01H', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(GetPlayableMapRect()), bj_UNIT_FACING)
                                        call CreateNUnitsAtLoc(1, 'n01H', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(GetPlayableMapRect()), bj_UNIT_FACING)
                                    else
                                        call RemoveWeatherEffect(GetLastCreatedWeatherEffect())
                                        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_047")
                                    endif
                                endif
                            endif
                        endif
                    endif
                endif
            endif
        endif
    endif
    call EnableWeatherEffect(GetLastCreatedWeatherEffect(), true)
endfunction

//===========================================================================
function InitTrig_tianqi takes nothing returns nothing
    set gg_trg_tianqi=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_tianqi, 180.00)
    call TriggerAddAction(gg_trg_tianqi, function Trig_tianqiActions)
endfunction

