endfunction

function Trig_Zombie_5Actions takes nothing returns nothing
    set udg_mubei[GetConvertedPlayerId(GetTriggerPlayer())]=GetTriggerUnit()
    set udg_mubei2[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetLoc()
    call TriggerSleepAction(2)
    call CreateNUnitsAtLoc(1, 'o00J', GetOwningPlayer(GetTriggerUnit()), udg_mubei2[GetConvertedPlayerId(GetTriggerPlayer())], 0.00)
    set udg_mubei3=GetLastCreatedUnit()
    call AddSpecialEffectLocBJ(GetUnitLoc(GetLastCreatedUnit()), "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call YDWEPolledWaitNull(80.00)
    call KillUnit(udg_mubei3)
    call RemoveLocation(udg_mubei2[GetConvertedPlayerId(GetTriggerPlayer())])
endfunction

