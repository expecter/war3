    return ( ( UnitHasItemOfTypeBJ(GetAttacker(), 'I00H') == true ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(GetTriggerUnit()))) <= 280 ) and ( IsUnitIllusionBJ(GetAttacker()) == false ) )
endfunction

function Trig_shuangzhiaishang_gongjiFunc001Func001001003 takes nothing returns boolean
    return ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetAttacker())) == true ) )
endfunction

function Trig_shuangzhiaishang_gongjiFunc001Func001A takes nothing returns nothing
    call UnitDamageTarget(GetAttacker(), GetEnumUnit(), 300.00, true, true, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

function Trig_shuangzhiaishang_gongjiActions takes nothing returns nothing
    if ( ( GetRandomInt(1, 6) == 6 ) ) then
