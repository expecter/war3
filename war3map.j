    set gg_trg_liliangtisheng=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_liliangtisheng, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_liliangtisheng, Condition(function Trig_liliangtishengConditions))
    call TriggerAddAction(gg_trg_liliangtisheng, function Trig_liliangtishengActions)
