    set gg_trg_qilinjian_gongji=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_qilinjian_gongji, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_qilinjian_gongji, Condition(function Trig_qilinjian_gongjiConditions))
    call TriggerAddAction(gg_trg_qilinjian_gongji, function Trig_qilinjian_gongjiActions)
endfunction

