        call EnableTrigger(gg_trg_qiangjijianshi)
        call EnableTrigger(gg_trg_jindujianshi)
        call EnableTrigger(gg_trg_gaoyadianping)
        call EnableTrigger(gg_trg_henengdantou)
        call EnableTrigger(gg_trg_shizhongqie2)
        call EnableTrigger(gg_trg_taxuewuhen2)
        call EnableTrigger(gg_trg_hongseshoutao)
        call EnableTrigger(gg_trg_anshadao)
        call EnableTrigger(gg_trg_cunzheng1)
        call EnableTrigger(gg_trg_yueyingzhiren1)
        call EnableTrigger(gg_trg_mingwangjia1)
        call EnableTrigger(gg_trg_fengwuqixiazhang)
        call EnableTrigger(gg_trg_miyao1)
        call EnableTrigger(gg_trg_yuangumiyao1)
        call EnableTrigger(gg_trg_tianxiawushuangdao3)
        call EnableTrigger(gg_trg_tianxiawushuangdao4)
        call EnableTrigger(gg_trg_shangdizhijie)
        call EnableTrigger(gg_trg_shenglingbaoyu2)
        call EnableTrigger(gg_trg_cangqiongzhishi)
        call EnableTrigger(gg_trg_haimachuishi)
        set udg_jiaqian=0
    else
    endif
    call YDWEPolledWaitNull(5.00)
    set udg_jiaqian=0
endfunction

