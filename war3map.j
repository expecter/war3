//===========================================================================
// Trigger: zuorezhidao
//
// 合成物品
//===========================================================================
function Trig_zuorezhidaoConditions takes nothing returns boolean
    return ( ( GetItemTypeId(GetManipulatedItem()) == 'I03L' ) )
endfunction

function Trig_zuorezhidaoActions takes nothing returns nothing
    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'rat9') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'ofir') == true ) ) then
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'rat9'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I03L'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'ofir'))
        call UnitAddItemByIdSwapped('srbd', GetTriggerUnit())
    else
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I03L'))
        call AdjustPlayerStateBJ(875, GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)
    endif
endfunction

//===========================================================================
function InitTrig_zuorezhidao takes nothing returns nothing
    set gg_trg_zuorezhidao=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_zuorezhidao, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_zuorezhidao, Condition(function Trig_zuorezhidaoConditions))
    call TriggerAddAction(gg_trg_zuorezhidao, function Trig_zuorezhidaoActions)
endfunction

