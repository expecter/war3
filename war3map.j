//===========================================================================
// Trigger: beigongji4
//===========================================================================
function Trig_beigongji4Actions takes nothing returns nothing
    set udg_mimishangdian=( udg_mimishangdian + 1 )
    if ( ( udg_mimishangdian <= 10 ) ) then
        call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 1.00, ( "德拉克苏尔 ： 我说了，我只对会员出售商品，杀了我也没用……" ))
    else
        if ( ( udg_mimishangdian <= 15 ) ) then
            call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 1.00, ( "德拉克苏尔 ： 饶了我吧，求你了……" ))
        else
            if ( ( udg_mimishangdian <= 18 ) ) then
                call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 1.00, ( "德拉克苏尔 ： 不要杀我，我什么都告诉你。" ))
            else
                if ( ( udg_mimishangdian == 20 ) ) then
                    call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 1.00, ( "德拉克苏尔 ： 拿去吧混蛋，我也不知道有什么用。" ))
                    call CreateItemLoc('I00L', PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 100.00, 0))
                    call DisableTrigger(GetTriggeringTrigger())
                else
                endif
            endif
        endif
    endif
endfunction

