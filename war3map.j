    return ( ( UnitHasBuffBJ(GetAttacker(), 'B02G') == true ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(GetTriggerUnit()))) <= 300 ) )
endfunction

