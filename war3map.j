    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I029') == true ) ) then
        call UnitAddAbilityBJ('A03E', gg_unit_o000_0280)
        call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 30, ( "德拉克苏尔 ： 对，这就是我们的会员证，我能为您服务吗？" ))
    else
        call UnitRemoveAbilityBJ('A03E', gg_unit_o000_0280)
    endif
endfunction

