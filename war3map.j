endfunction

function Trig_shengmolushiyongActions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=40
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitManaPercentBJ(GetTriggerUnit(), 100)
        call YDWEPolledWaitNull(1.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_shengmolushiyong takes nothing returns nothing
    set gg_trg_shengmolushiyong=CreateTrigger()
