//===========================================================================
// Trigger: kongju
//===========================================================================
function Trig_kongjuConditions takes nothing returns boolean
    return ( ( GetItemTypeId(GetManipulatedItem()) == 'I02N' ) )
endfunction

function Trig_kongjuActions takes nothing returns nothing
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'Udre' ) ) then
        call YDWEReplaceUnitBJNull(GetTriggerUnit() , 'Utic' , bj_UNIT_STATE_METHOD_RELATIVE)
        call AddSpecialEffectLocBJ(GetUnitLoc(GetTriggerUnit()), "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 15.00, "TRIGSTR_3391")
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetLastReplacedUnitBJ(), 'I02N'))
    else
        call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetTriggerPlayer()), 5.00, "TRIGSTR_3392")
        call SetUnitLifePercentBJ(GetTriggerUnit(), 2.00)
        call SetUnitManaPercentBJ(GetTriggerUnit(), 100)
        call AddSpecialEffectLocBJ(GetUnitLoc(GetTriggerUnit()), "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
        call DestroyEffect(GetLastCreatedEffectBJ())
        call UnitResetCooldown(GetTriggerUnit())
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I02N'))
    endif
endfunction

//===========================================================================
function InitTrig_kongju takes nothing returns nothing
    set gg_trg_kongju=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_kongju, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_kongju, Condition(function Trig_kongjuConditions))
    call TriggerAddAction(gg_trg_kongju, function Trig_kongjuActions)
endfunction

