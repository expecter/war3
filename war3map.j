//===========================================================================
// Trigger: Nuclear Strike
//===========================================================================
function Trig_Nuclear_StrikeConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0CH' ) )
endfunction

function Trig_Nuclear_StrikeFunc024A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'h005', GetTriggerPlayer(), GetUnitLoc(GetEnumUnit()), bj_UNIT_FACING)
    call IssueTargetOrder(GetLastCreatedUnit(), "lightningshield", GetLastCreatedUnit())
endfunction

function Trig_Nuclear_StrikeActions takes nothing returns nothing
    local effect l__udg_point
    local unit array smoke_unit
    call PlaySoundAtPointBJ(gg_snd_TGhLas00, 100, udg_target[GetConvertedPlayerId(GetTriggerPlayer())], 0)
    set udg_target[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetLoc()
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_034")
    call AddSpecialEffectLocBJ(udg_target[GetConvertedPlayerId(GetTriggerPlayer())], "Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl")
    set l__udg_point=GetLastCreatedEffectBJ()
    call TriggerSleepAction(1.00)
    if ( ( udg_stopped[GetConvertedPlayerId(GetTriggerPlayer())] == true ) ) then
        call DestroyEffect(l__udg_point)
        return
    else
        call DoNothing()
    endif
    call PlaySoundAtPointBJ(gg_snd_tadUPD04, 100, udg_target[GetConvertedPlayerId(GetTriggerPlayer())], 0)
    call TriggerSleepAction(4.00)
    if ( ( udg_stopped[GetConvertedPlayerId(GetTriggerPlayer())] == true ) ) then
        call DestroyEffect(l__udg_point)
        return
    else
        call DoNothing()
    endif
    call CreateNUnitsAtLoc(1, 'h00E', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(udg_target[GetConvertedPlayerId(GetTriggerPlayer())], 30.00, 0), bj_UNIT_FACING)
    call IssuePointOrderLoc(GetLastCreatedUnit(), "attackground", udg_target[GetConvertedPlayerId(GetTriggerPlayer())])
    call TriggerSleepAction(3.25)
    call PlaySoundAtPointBJ(gg_snd_BuildingDeathLargeHuman, 100, udg_target[GetConvertedPlayerId(GetTriggerPlayer())], 0)
    call DestroyEffect(l__udg_point)
    call CreateNUnitsAtLoc(1, 'h003', GetOwningPlayer(GetTriggerUnit()), udg_target[GetConvertedPlayerId(GetTriggerPlayer())], bj_UNIT_FACING)
    call SetUnitAnimation(GetLastCreatedUnit(), "death")
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 10.00)
    call PlaySoundAtPointBJ(gg_snd_MortarImpact, 100.00, udg_target[GetConvertedPlayerId(GetTriggerPlayer())], 0)
    call PlaySoundAtPointBJ(gg_snd_NightElfBuildingDeathLarge1, 100.00, udg_target[GetConvertedPlayerId(GetTriggerPlayer())], 0)
    call TriggerSleepAction(0.50)
    call ForGroupBJ((YDWEGetUnitsInRangeOfLocMatchingNull(((600.00 )*1.0) , ( udg_target[GetConvertedPlayerId(GetTriggerPlayer())]) , null)), function Trig_Nuclear_StrikeFunc024A) // INLINED!!
    call TerrainDeformationRippleBJ(3.00, false, udg_target[GetConvertedPlayerId(GetTriggerPlayer())], 975.00, 1000.00, - 50.00, 4.00, 1800.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'h009', GetOwningPlayer(GetTriggerUnit()), udg_target[GetConvertedPlayerId(GetTriggerPlayer())], bj_UNIT_FACING)
        set udg_smoke[GetForLoopIndexA()]=GetLastCreatedUnit()
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RemoveUnit(udg_smoke[GetForLoopIndexA()])
        call TriggerSleepAction(5.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

