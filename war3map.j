endfunction

function Trig_shengjiActions takes nothing returns nothing
    call SetItemCharges(GetItemOfTypeFromUnitBJ(GetKillingUnitBJ(), 'I023'), ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetKillingUnitBJ(), 'I023')) + 1 ))
    call AddSpecialEffectTargetUnitBJ("origin", GetKillingUnitBJ(), "Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
    call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetOwningPlayer(GetKillingUnitBJ())), 10.00, "TRIGSTR_5497")
endfunction

