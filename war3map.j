// Trigger: shanghai
//===========================================================================
function Trig_shanghaiConditions takes nothing returns boolean
    return ( ( UnitHasItemOfTypeBJ(GetAttacker(), 'I023') == true ) and ( R2I(DistanceBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(GetTriggerUnit()))) >= 300 ) and ( IsUnitIllusionBJ(GetAttacker()) == false ) )
endfunction

function Trig_shanghaiActions takes nothing returns nothing
    call YDWEPolledWaitNull(0.50)
    call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), ( 30.00 * I2R(GetItemCharges(GetItemOfTypeFromUnitBJ(GetAttacker(), 'I023'))) ), true, true, ATTACK_TYPE_PIERCE, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Weapons\\WingedSerpentMissile\\WingedSerpentMissile.mdl")
    call DestroyEffect(GetLastCreatedEffectBJ())
endfunction

//===========================================================================
function InitTrig_shanghai takes nothing returns nothing
    set gg_trg_shanghai=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_shanghai, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_shanghai, Condition(function Trig_shanghaiConditions))
    call TriggerAddAction(gg_trg_shanghai, function Trig_shanghaiActions)
endfunction

