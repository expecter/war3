//===========================================================================
// Trigger: AI shezhi
//===========================================================================
function Trig_AI_shezhiActions takes nothing returns nothing
    if ( ( GetRandomInt(1, 2) == 1 ) ) then
        call EnableTrigger(gg_trg_emolieshou_t1)
    else
        call EnableTrigger(gg_trg_emolieshou_t2)
    endif
    if ( ( GetRandomInt(3, 4) == 3 ) ) then
        call EnableTrigger(gg_trg_damao_t1)
    else
        call EnableTrigger(gg_trg_damao_t2)
    endif
    if ( ( GetRandomInt(5, 6) == 5 ) ) then
