//===========================================================================
// Trigger: nianchouwang
//
// 合成物品
//===========================================================================
function Trig_nianchouwangConditions takes nothing returns boolean
    return ( ( GetItemTypeId(GetManipulatedItem()) == 'I0A8' ) )
endfunction

function Trig_nianchouwangActions takes nothing returns nothing
    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I081') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I03K') == true ) ) then
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I081'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I03K'))
        call UnitAddItemByIdSwapped('I0A6', GetTriggerUnit())
    else
        if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I081') == true ) and ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I086') == true ) ) then
            call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I081'))
            call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I086'))
            call UnitAddItemByIdSwapped('I0A7', GetTriggerUnit())
        else
            call AdjustPlayerStateBJ(500, GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)
        endif
    endif
endfunction

//===========================================================================
function InitTrig_nianchouwang takes nothing returns nothing
    set gg_trg_nianchouwang=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_nianchouwang, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_nianchouwang, Condition(function Trig_nianchouwangConditions))
    call TriggerAddAction(gg_trg_nianchouwang, function Trig_nianchouwangActions)
endfunction

