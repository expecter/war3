//===========================================================================
// Trigger: shabing jinqiandai
//===========================================================================
function Trig_shabing_jinqiandaiConditions takes nothing returns boolean
    return ( ( IsUnitEnemy(GetTriggerUnit(), Player(11)) == true ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == false ) and ( IsUnitInGroup(GetKillingUnitBJ(), (YDWEGetUnitsOfPlayerMatchingNull((Player(11)) , null))) == false ) and ( IsUnitType(GetKillingUnitBJ(), UNIT_TYPE_STRUCTURE) == false ) and ( UnitHasItemOfTypeBJ(GetKillingUnitBJ(), 'drph') == true ) ) // INLINED!!
endfunction

function Trig_shabing_jinqiandaiActions takes nothing returns nothing
    call AdjustPlayerStateBJ(( GetUnitLevel(GetTriggerUnit()) * 10 ), GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD)
    call DisplayTimedTextToForce(YDWEGetForceOfPlayerNull(GetOwningPlayer(GetKillingUnitBJ())), 10.00, ( "|cffffcc00聚财袋获取附加金钱：" + I2S(( GetUnitLevel(GetTriggerUnit()) * 10 )) ))
endfunction

//===========================================================================
function InitTrig_shabing_jinqiandai takes nothing returns nothing
    set gg_trg_shabing_jinqiandai=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_shabing_jinqiandai, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_shabing_jinqiandai, Condition(function Trig_shabing_jinqiandaiConditions))
    call TriggerAddAction(gg_trg_shabing_jinqiandai, function Trig_shabing_jinqiandaiActions)
endfunction

//===========================================================================
// Trigger: pk
//===========================================================================
function Trig_pkConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0OD' ) )
endfunction

function Trig_pkActions takes nothing returns nothing
    call SetPlayerAllianceStateBJ(GetTriggerPlayer(), Player(1), bj_ALLIANCE_UNALLIED)
endfunction

//===========================================================================
function InitTrig_pk takes nothing returns nothing
    set gg_trg_pk=CreateTrigger()
