    return ( ( UnitHasBuffBJ(udg_huoshi[GetConvertedPlayerId(GetTriggerPlayer())], 'B02I') == false ) )
endfunction

function Trig_youlingzhanshiActions takes nothing returns nothing
    set udg_huoshi[GetConvertedPlayerId(GetTriggerPlayer())]=GetSpellTargetUnit()
    call UnitAddAbilityBJ('A0J1', udg_huoshi[GetConvertedPlayerId(GetTriggerPlayer())])
    call YDWEPolledWaitNull(1.00)
    loop
        exitwhen ( (UnitHasBuffBJ(udg_huoshi[GetConvertedPlayerId(GetTriggerPlayer())], 'B02I') == false) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    call UnitRemoveAbilityBJ('A0J1', udg_huoshi[GetConvertedPlayerId(GetTriggerPlayer())])
endfunction

