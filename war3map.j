function Trig_mofajiejieshengjiActions takes nothing returns nothing
    if ( ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetKillingUnitBJ(), 'I07G')) < 5 ) ) then
        call SetItemCharges(GetItemOfTypeFromUnitBJ(GetKillingUnitBJ(), 'I07G'), ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetKillingUnitBJ(), 'I07G')) + 1 ))
